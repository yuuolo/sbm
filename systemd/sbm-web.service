[Unit]
Description=sbm web admin (sing-box user & subscription manager)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/sbm-web/app.py
WorkingDirectory=/opt/sbm-web
Restart=on-failure
RestartSec=3
# 需要 root：读写 /etc/sbm、/var/www/sub，并使用 /root/.ssh/sbm_node 登录节点
# 部署新节点时还要运行 certbot、记录新节点的 SSH 主机密钥
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/sbm /var/www/sub /root/.ssh /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt -/var/backups/sbm
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
