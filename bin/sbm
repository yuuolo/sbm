def outbound_singbox(node, user):
    return {
        "type": "anytls",
        "tag": node["name"],
        "server": node["server"],
        "server_port": node["port"],
        "password": user["password"],
        "tls": {
            "enabled": True,
            "server_name": node["sni"],
            "utls": {"enabled": True, "fingerprint": "chrome"},
        },
    }


# ---------- 代理组与分流（sing-box 与 Clash 共用同一份规划） ----------
# 参照常见的 ACL4SSR 精简分组；规则数据统一用 MetaCubeX/meta-rules-dat，
# sing-box 用其 .srs 规则集，Clash Meta 用同源的 geosite/geoip 数据，两边分类一致。

G_PROXY, G_AUTO, G_FALLBACK = "🚀 节点选择", "♻️ 自动选择", "🔯 故障转移"
G_ADS, G_DIRECT, G_FINAL = "🛑 广告拦截", "🎯 全球直连", "🐟 漏网之鱼"
TEST_URL = "https://www.gstatic.com/generate_204"
RULESET_URL = "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/{kind}/{name}.srs"

# 按节点名称自动归入地区组（取第一个匹配的地区；匹配不到的节点只出现在节点选择里）
REGIONS = [
    ("🇭🇰 香港节点", r"香港|(^|[^a-z])(hk|hong ?kong)([^a-z]|$)"),
    ("🇹🇼 台湾节点", r"台湾|(^|[^a-z])(tw|taiwan|taipei)([^a-z]|$)"),
    ("🇯🇵 日本节点", r"日本|东京|大阪|(^|[^a-z])(jp|japan|tokyo|osaka)([^a-z]|$)"),
    ("🇸🇬 新加坡节点", r"新加坡|狮城|(^|[^a-z])(sg|singapore)([^a-z]|$)"),
    ("🇰🇷 韩国节点", r"韩国|首尔|(^|[^a-z])(kr|korea|seoul)([^a-z]|$)"),
    ("🇺🇸 美国节点", r"美国|(^|[^a-z])(us|usa|america|los ?angeles|san ?jose|seattle)([^a-z]|$)"),
]

# 分流服务组目录：(key, 组名, 默认选项, geosite 列表, geoip 列表, 默认配置是否启用)
# 默认选项："proxy" 走节点选择，"direct" 直连，"region:<组名>" 优先该地区，"node:<节点名>" 优先该节点
# （地区或节点不在订阅里时退回节点选择）。
# 规则按这个顺序匹配，范围小的排在前面：geosite:microsoft 包含 GitHub，geoip:google 的范围比 YouTube 大。
# GitHub 默认启用：否则它会命中默认直连的微软规则，而 GitHub 在国内直连经常打不开，
# Clash 从 GitHub 自动更新规则数据时也走这条规则，所以它也是更新能经节点完成的前提
SERVICES = [
    ("ai", "🤖 AI 服务", "region:🇺🇸 美国节点", ["category-ai-!cn"], [], True),
    ("youtube", "📹 YouTube", "proxy", ["youtube"], [], True),
    ("netflix", "🎥 Netflix", "proxy", ["netflix"], ["netflix"], True),
    ("disney", "🏰 Disney+", "proxy", ["disney"], [], False),
    ("hbo", "🎬 HBO", "proxy", ["hbo"], [], False),
    ("primevideo", "📦 Prime Video", "proxy", ["primevideo"], [], False),
    ("spotify", "🎧 Spotify", "proxy", ["spotify"], [], False),
    ("tiktok", "🎵 TikTok", "proxy", ["tiktok"], [], False),
    ("telegram", "📲 Telegram", "proxy", ["telegram"], ["telegram"], True),
    ("whatsapp", "💬 WhatsApp", "proxy", ["whatsapp"], [], False),
    ("discord", "🎙️ Discord", "proxy", ["discord"], [], False),
    ("instagram", "📷 Instagram", "proxy", ["instagram"], [], False),
    ("facebook", "👥 Facebook", "proxy", ["facebook"], ["facebook"], False),
    ("twitter", "🐦 X / Twitter", "proxy", ["twitter"], ["twitter"], False),
    ("github", "🐙 GitHub", "proxy", ["github"], [], True),
    ("google", "🔍 谷歌服务", "proxy", ["google"], ["google"], False),
    ("steam", "🕹️ Steam", "proxy", ["steam"], [], False),
    ("microsoft", "Ⓜ️ 微软服务", "direct", ["microsoft"], [], True),
    ("apple", "🍎 苹果服务", "direct", ["apple"], [], True),
]


# ---------- 订阅配置 ----------
# 每个用户使用一份配置，决定订阅里的节点、分流模式、服务组和自定义规则。
# 默认配置内置在程序里（不可修改），没有设置配置的用户都用它；新增的配置存在 profiles.json。
# 切换配置只重新生成订阅，节点上的账号不变，节点不重启。

PROFILES = f"{ETC}/profiles.json"
DEFAULT_PROFILE = "default"
DEFAULT_PROFILE_NAME = "默认配置"
PROFILE_ID_RE = re.compile(r"^[0-9a-f]{8}$")
PROFILE_NAME_MAX = 32
PROFILE_NOTE_MAX = 64
CUSTOM_RULES_MAX = 200
RULE_TYPES = {"domain_suffix": "域名后缀", "domain": "完整域名", "domain_keyword": "域名关键字", "ip_cidr": "IP 段"}
# 应用分流：sing-box 的字段名就是这两个 key。process_name 只在 Windows、macOS、Linux 上生效，
# package_name 只在安卓上生效；iOS 拿不到发起连接的应用，这些规则不起作用
APP_RULE_TYPES = {"process_name": "进程名", "package_name": "安卓包名"}
DOMAIN_RULE_TYPES = ("domain_suffix", "domain", "domain_keyword")
PROCESS_RE = re.compile(r"^[^\x00-\x1f\x7f,\"/\\:*?<>|]{1,128}$")
PACKAGE_RE = re.compile(r"^(?=.{1,128}$)[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$")
DOMAIN_RE = re.compile(r"^(?=.{1,253}$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$")
KEYWORD_RE = re.compile(r"^[a-z0-9.-]{1,64}$")


def default_profile():
    return {
        "id": DEFAULT_PROFILE, "name": DEFAULT_PROFILE_NAME, "note": "内置配置，不能修改；没有指定配置的用户都用它",
        "builtin": True, "nodes": None, "mode": "rule", "main": "auto", "ads": True,
        "services": {key: {"enabled": on, "default": default} for key, _t, default, _gs, _gi, on in SERVICES},
        "custom_rules": [], "app_rules": [],
    }


def load_profiles():
    return load(PROFILES, {"profiles": []})["profiles"]


def save_profiles(profiles):
    write_file(PROFILES, json.dumps({"profiles": profiles}, indent=2, ensure_ascii=False) + "\n", 0o600)


def all_profiles():
    return [default_profile(), *load_profiles()]


def get_profile(profiles, pid):
    for p in profiles:
        if p["id"] == pid:
            return p
    raise SbmError("配置不存在")


def user_profile(user, profiles):
    """用户使用的配置；没有设置，或配置已不存在时用默认配置。"""
    pid = user.get("profile")
    return next((p for p in profiles if p["id"] == pid), None) or default_profile()


def set_user_profile(user, profiles, pid):
    """默认配置不写入用户数据，没有用这个功能时 users.json 不变。"""
    if not pid or pid == DEFAULT_PROFILE:
        user.pop("profile", None)
    else:
        user["profile"] = get_profile(profiles, pid)["id"]


def profile_nodes(conf, profile):
    """配置包含的节点，顺序同节点列表。选中的节点都被删除时退回全部，订阅不能变成空的。"""
    if not profile["nodes"]:
        return conf["nodes"]
    return [n for n in conf["nodes"] if n["name"] in profile["nodes"]] or conf["nodes"]


def _clean_choice(conf, value, plain, what):
    v = str(value or "")
    if v in plain:
        return v
    if v.startswith("region:") and v[7:] in [t for t, _p in REGIONS]:
        return v
    if v.startswith("node:") and v[5:] in [n["name"] for n in conf["nodes"]]:
        return v
    raise SbmError(f"{what}的选项无效：{v}")


def _clean_rule(conf, rule):
    if not isinstance(rule, dict) or rule.get("type") not in RULE_TYPES:
        raise SbmError("自定义规则的类型无效")
    kind, value = rule["type"], str(rule.get("value") or "").strip()
    if not value:
        raise SbmError("自定义规则不能留空")
    if kind == "ip_cidr":
        try:
            value = str(ipaddress.ip_network(value, strict=False))
        except ValueError:
            raise SbmError(f"IP 段格式不对：{value}（例如 203.0.113.0/24）")
    elif kind == "domain_keyword":
        value = value.lower()
        if not KEYWORD_RE.match(value):
            raise SbmError(f"域名关键字只能包含字母、数字、. -：{value}")
    else:
        raw = value
        value = value.lower()
        if kind == "domain_suffix":  # 常见写法 *.example.com、.example.com 都当作 example.com
            value = value.removeprefix("*.").removeprefix(".")
        try:
            value = value.encode("idna").decode()  # 中文域名转成 punycode
        except UnicodeError:
            raise SbmError(f"域名格式不对：{raw}")
        if not DOMAIN_RE.match(value):
            raise SbmError(f"域名格式不对：{raw}（例如 example.com）")
    return {"type": kind, "value": value,
            "target": _clean_choice(conf, rule.get("target"), ("direct", "reject", "proxy"), f"规则 {value} ")}


def _clean_app_rule(conf, rule):
    if not isinstance(rule, dict) or rule.get("type") not in APP_RULE_TYPES:
        raise SbmError("应用规则的类型无效")
    kind, value = rule["type"], str(rule.get("value") or "").strip()
    if not value:
        raise SbmError("应用规则不能留空")
    if kind == "process_name" and not PROCESS_RE.match(value):
        raise SbmError(f"进程名格式不对：{value}（只填文件名，例如 WeChat.exe，不要路径和逗号）")
    if kind == "package_name" and not PACKAGE_RE.match(value):
        raise SbmError(f"安卓包名格式不对：{value}（例如 com.tencent.mm）")
    return {"type": kind, "value": value,
            "target": _clean_choice(conf, rule.get("target"), ("direct", "reject", "proxy"), f"应用 {value} ")}


def normalize_profile(conf, data):
    """校验控制台提交的配置，返回只含已知字段的配置。这些内容会写进下发的订阅，所以一律严格校验。"""
    if not isinstance(data, dict):
        raise SbmError("配置格式不对")
    name = str(data.get("name") or "").strip()
    note = str(data.get("note") or "").strip()
    if not name or len(name) > PROFILE_NAME_MAX or any(ord(c) < 32 for c in name):
        raise SbmError(f"配置名称不能为空，最长 {PROFILE_NAME_MAX} 个字符")
    if len(note) > PROFILE_NOTE_MAX:
        raise SbmError(f"备注最长 {PROFILE_NOTE_MAX} 个字符")
    nodes = data.get("nodes")
    if nodes is not None:
        known = [n["name"] for n in conf["nodes"]]
        if not isinstance(nodes, list) or not nodes:
            raise SbmError("至少选择一个节点")
        for n in nodes:
            if n not in known:
                raise SbmError(f"节点 {n} 不存在")
        nodes = [n for n in known if n in nodes]
    mode = data.get("mode")
    if mode not in ("rule", "global"):
        raise SbmError("分流模式无效")
    given = data.get("services") or {}
    if not isinstance(given, dict):
        raise SbmError("服务组格式不对")
    services = {}
    for key, title, default, _gs, _gi, on in SERVICES:
        item = given.get(key)
        item = item if isinstance(item, dict) else {}
        services[key] = {"enabled": bool(item.get("enabled", on)),
                         "default": _clean_choice(conf, item.get("default", default), ("proxy", "direct"), f"{title} ")}
    rules = data.get("custom_rules") or []
    if not isinstance(rules, list) or len(rules) > CUSTOM_RULES_MAX:
        raise SbmError(f"自定义规则最多 {CUSTOM_RULES_MAX} 条")
    apps = data.get("app_rules") or []
    if not isinstance(apps, list) or len(apps) > CUSTOM_RULES_MAX:
        raise SbmError(f"应用规则最多 {CUSTOM_RULES_MAX} 条")
    return {
        "name": name, "note": note, "nodes": nodes, "mode": mode,
        "main": _clean_choice(conf, data.get("main", "auto"), ("auto",), "默认出口"),
        "ads": bool(data.get("ads", True)), "services": services,
        "custom_rules": [_clean_rule(conf, r) for r in rules],
        "app_rules": [_clean_app_rule(conf, r) for r in apps],
    }


def profile_save(conf, profiles, data, pid=None):
    """新建（pid 为空）或修改配置，只改内存中的 profiles。"""
    if pid == DEFAULT_PROFILE:
        raise SbmError("默认配置不能修改，可以复制一份再改")
    p = normalize_profile(conf, data)
    if p["name"] == DEFAULT_PROFILE_NAME or any(x["name"] == p["name"] and x["id"] != pid for x in profiles):
        raise SbmError(f"配置名称 {p['name']} 已存在")
    if pid:
        old = get_profile(profiles, pid)
        p["id"] = pid
        profiles[profiles.index(old)] = p
    else:
        p["id"] = secrets.token_hex(4)
        profiles.append(p)
    return p


def profile_delete(profiles, users, pid):
    """删除配置，正在用它的用户回到默认配置，返回这些用户的数量。"""
    if pid == DEFAULT_PROFILE:
        raise SbmError("默认配置不能删除")
    p = get_profile(profiles, pid)
    moved = [u for u in users if u.get("profile") == pid]
    for u in moved:
        u.pop("profile")
    profiles.remove(p)
    return len(moved)


def _option_ref(choice, region_titles, names):
    """配置里的选择换成代理组或节点名；地区或节点不在这份订阅里时退回节点选择。"""
    if choice.startswith("region:") and choice[7:] in region_titles:
        return choice[7:]
    if choice.startswith("node:") and choice[5:] in names:
        return choice[5:]
    return G_PROXY


def group_plan(nodes, profile):
    """返回 (地区组 [(组名, [节点名])], 服务组 [(组名, [选项...默认在第一个], geosite, geoip)])。
    选项里用 "DIRECT" 表示直连，由各格式自己换成对应的写法。全局代理模式没有服务组。"""
    names = [n["name"] for n in nodes]
    regions, used = [], set()
    for title, pattern in REGIONS:
        members = [n for n in names if n not in used and re.search(pattern, n, re.I)]
        if members:
            regions.append((title, members))
            used.update(members)
    region_titles = [r[0] for r in regions]
    pool = [G_PROXY, G_AUTO, *region_titles, *names]
    services = []
    for key, title, _default, geosite, geoip, _on in (SERVICES if profile["mode"] == "rule" else []):
        item = profile["services"].get(key)
        if not item or not item["enabled"]:
            continue
        first = _option_ref(item["default"], region_titles, names)
        if item["default"] == "direct":
            options = ["DIRECT", *pool]
        elif first != G_PROXY:
            options = [first, *[x for x in pool if x != first], "DIRECT"]
        else:
            options = [*pool, "DIRECT"]
        services.append((title, options, geosite, geoip))
    return regions, services


def main_choice(profile, regions, names):
    """节点选择组的默认项。"""
    choice = _option_ref(profile["main"], [r[0] for r in regions], names)
    return G_AUTO if choice == G_PROXY else choice


def custom_targets(profile, regions, names):
    """自定义规则和应用规则及其去向：[(规则, "DIRECT" / "REJECT" / 代理组或节点名)]。
    域名和 IP 规则的范围比整个应用小，所以排在应用规则前面。"""
    titles = [r[0] for r in regions]
    plain = {"direct": "DIRECT", "reject": "REJECT"}
    return [(r, plain.get(r["target"]) or _option_ref(r["target"], titles, names))
            for r in [*profile["custom_rules"], *profile.get("app_rules", [])]]  # 旧配置没有 app_rules


def first_of(item, items):
    return [item, *[x for x in items if x != item]]


def build_singbox(conf, user, profile=None):
    profile = profile or default_profile()
    nodes = profile_nodes(conf, profile)
    names = [n["name"] for n in nodes]
    regions, services = group_plan(nodes, profile)
    rule_mode = profile["mode"] == "rule"
    main = main_choice(profile, regions, names)
    sb = lambda x: "direct" if x == "DIRECT" else x  # noqa: E731

    def urltest(tag, members):
        if not members:  # 还没有节点时 urltest 不能为空，先占位为直连
            return {"type": "selector", "tag": tag, "outbounds": ["direct"]}
        return {"type": "urltest", "tag": tag, "outbounds": members, "url": TEST_URL, "interval": "5m", "tolerance": 50}
    rule_sets = {}

    def rs(kind, name):
        tag = f"{kind}-{name}"
        rule_sets[tag] = {"type": "remote", "tag": tag, "format": "binary",
                          "url": RULESET_URL.format(kind=kind, name=name), "download_detour": G_PROXY}
        return tag

    route_rules = [
        {"action": "sniff"},
        {"protocol": "dns", "action": "hijack-dns"},
        {"ip_is_private": True, "outbound": "direct"},
        {"rule_set": [rs("geosite", "private")], "outbound": "direct"},
    ]
    custom = custom_targets(profile, regions, names)
    for rule, target in custom:
        action = {"action": "reject"} if target == "REJECT" else {"outbound": sb(target)}
        route_rules.append({rule["type"]: [rule["value"]], **action})
    if profile["ads"]:
        # sing-box 1.11 起没有可选的 block 出站，广告直接拒绝
        route_rules.append({"rule_set": [rs("geosite", "category-ads-all")], "action": "reject"})
    for title, _options, geosite, geoip in services:
        route_rules.append({"rule_set": [rs("geosite", g) for g in geosite] + [rs("geoip", g) for g in geoip],
                            "outbound": title})
    if rule_mode:
        route_rules += [
            {"rule_set": [rs("geosite", "geolocation-!cn")], "outbound": G_PROXY},
            {"rule_set": [rs("geosite", "cn"), rs("geoip", "cn")], "outbound": G_DIRECT},
        ]
    region_titles = [r[0] for r in regions]
    outbounds = [
        {"type": "selector", "tag": G_PROXY, "outbounds": first_of(main, [G_AUTO, *region_titles, *names, "direct"]),
         "default": main},
        urltest(G_AUTO, names),
        *[urltest(title, members) for title, members in regions],
        *[{"type": "selector", "tag": title, "outbounds": [sb(o) for o in options], "default": sb(options[0])}
          for title, options, _gs, _gi in services],
        *([{"type": "selector", "tag": G_DIRECT, "outbounds": ["direct", G_PROXY], "default": "direct"},
           {"type": "selector", "tag": G_FINAL, "outbounds": [G_PROXY, "direct", G_AUTO, *region_titles, *names],
            "default": G_PROXY}] if rule_mode else []),
        *[outbound_singbox(n, user) for n in nodes],
        {"type": "direct", "tag": "direct"},
    ]
    # TUN 模式下连接目标是 DNS 解析出的 IP，自定义规则里的域名也要用对应的 DNS：
    # 直连的用国内 DNS，走节点的用境外 DNS（被拒绝的不需要）
    dns_custom = [{rule["type"]: [rule["value"]], "server": "local" if target == "DIRECT" else "remote"}
                  for rule, target in custom if rule["type"] in DOMAIN_RULE_TYPES and target != "REJECT"]
    dns_rules = [
        # 已知境外域名：境外 DNS（经节点），避免被国内 DNS 污染，也不泄露给国内 DNS
        {"rule_set": ["geosite-geolocation-!cn"], "server": "remote"},
        # 已知国内域名：国内 DNS，拿到就近的国内 CDN 地址
        {"rule_set": ["geosite-cn", "geosite-private"], "server": "local"},
        # 列表外的域名：先问国内 DNS，结果是国内 IP 才采用（IP 规则集在 DNS 规则里是「地址过滤」），
        # 否则跳过本条交给 final 的境外 DNS。这样列表外的国内网站也能拿到国内 IP，按 geoip:cn 直连
        {"rule_set": ["geoip-cn"], "server": "local"},
    ] if rule_mode else [{"rule_set": ["geosite-private"], "server": "local"}]
    return {
        "log": {"level": "warn"},
        "dns": {
            "servers": [
                {"type": "https", "tag": "remote", "server": "1.1.1.1", "detour": G_PROXY},
                {"type": "https", "tag": "local", "server": "223.5.5.5"},
            ],
            "rules": [*dns_custom, *dns_rules],
            "final": "remote",
            "strategy": "prefer_ipv4",
        },
        "inbounds": [{
            "type": "tun",
            "tag": "tun-in",
            "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
            "auto_route": True,
            "strict_route": True,
        }],
        "outbounds": outbounds,
        "route": {
            "rules": route_rules,
            "rule_set": list(rule_sets.values()),
            "final": G_FINAL if rule_mode else G_PROXY,
            "auto_detect_interface": True,
            "default_domain_resolver": "local",
        },
        # cache_file 让客户端记住每个代理组的选择
        "experimental": {"cache_file": {"enabled": True}},
    }


def q(s):
    # JSON 字符串同时也是合法的 YAML 字符串
    return json.dumps(s, ensure_ascii=False)


def clash_custom_rule(rule, target):
    value = rule["value"]
    if rule["type"] == "ip_cidr":
        kind = "IP-CIDR6" if ":" in value else "IP-CIDR"
        return f"{kind},{value},{target},no-resolve"
    if rule["type"] in APP_RULE_TYPES:  # mihomo 在安卓上用 PROCESS-NAME 匹配包名
        return f"PROCESS-NAME,{value},{target}"
    kind = {"domain_suffix": "DOMAIN-SUFFIX", "domain": "DOMAIN", "domain_keyword": "DOMAIN-KEYWORD"}[rule["type"]]
    return f"{kind},{value},{target}"


def build_clash(conf, user, profile=None):
    profile = profile or default_profile()
    nodes = profile_nodes(conf, profile)
    lines = [
        "mixed-port: 7890",
        "allow-lan: false",
        "mode: rule",
        "log-level: warning",
        "ipv6: false",
        "unified-delay: true",
        "geodata-mode: true",
        # 默认只在首次运行时下载 geosite / geoip，打开后每 24 小时自动更新
        "geo-auto-update: true",
        "geo-update-interval: 24",
        "dns:",
        "  enable: true",
        "  enhanced-mode: fake-ip",
        "  fake-ip-range: 198.18.0.1/16",
        "  default-nameserver: [223.5.5.5, 119.29.29.29]",
        "  nameserver: [https://dns.alidns.com/dns-query, https://doh.pub/dns-query]",
        "  nameserver-policy:",
        f"    \"geosite:geolocation-!cn\": [{q('https://1.1.1.1/dns-query#' + G_PROXY)}]",
        "proxies:",
    ]
    for n in nodes:
        lines += [
            f"  - name: {q(n['name'])}",
            "    type: anytls",
            f"    server: {q(n['server'])}",
            f"    port: {n['port']}",
            f"    password: {q(user['password'])}",
            f"    sni: {q(n['sni'])}",
            "    client-fingerprint: chrome",
            "    skip-cert-verify: false",
            "    udp: true",
        ]
    names = [n["name"] for n in nodes]
    regions, services = group_plan(nodes, profile)
    region_titles = [r[0] for r in regions]
    rule_mode = profile["mode"] == "rule"
    main = main_choice(profile, regions, names)
    flow = lambda items: "[" + ", ".join(q(x) for x in items) + "]"  # noqa: E731

    def group(name, kind, members, test=False):
        if not members:  # 还没有节点时代理组不能为空，先占位为直连
            kind, members, test = "select", ["DIRECT"], False
        out = [f"  - name: {q(name)}", f"    type: {kind}", f"    proxies: {flow(members)}"]
        if test:
            out += [f"    url: {q(TEST_URL)}", "    interval: 300"] + (["    tolerance: 50"] if kind == "url-test" else [])
        return out

    lines.append("proxy-groups:")
    lines += group(G_PROXY, "select", first_of(main, [G_AUTO, G_FALLBACK, *region_titles, *names, "DIRECT"]))
    lines += group(G_AUTO, "url-test", names, test=True)
    lines += group(G_FALLBACK, "fallback", names, test=True)
    for title, members in regions:
        lines += group(title, "url-test", members, test=True)
    for title, options, _gs, _gi in services:
        lines += group(title, "select", options)
    if profile["ads"]:
        lines += group(G_ADS, "select", ["REJECT", "DIRECT"])
    if rule_mode:
        lines += group(G_DIRECT, "select", ["DIRECT", G_PROXY])
        lines += group(G_FINAL, "select", [G_PROXY, "DIRECT", G_AUTO, *region_titles, *names])

    rules = ["GEOSITE,private,DIRECT", "GEOIP,private,DIRECT,no-resolve"]
    for rule, target in custom_targets(profile, regions, names):
        rules.append(clash_custom_rule(rule, target))
    if profile["ads"]:
        rules.append(f"GEOSITE,category-ads-all,{G_ADS}")
    for title, _options, geosite, geoip in services:
        rules += [f"GEOSITE,{g},{title}" for g in geosite] + [f"GEOIP,{g},{title},no-resolve" for g in geoip]
    if rule_mode:
        rules += [f"GEOSITE,geolocation-!cn,{G_PROXY}", f"GEOSITE,cn,{G_DIRECT}", f"GEOIP,CN,{G_DIRECT}", f"MATCH,{G_FINAL}"]
    else:
        rules.append(f"MATCH,{G_PROXY}")
    lines.append("rules:")
    lines += [f"  - {q(r)}" for r in rules]
    return "\n".join(lines) + "\n"


def build_uri(conf, user, profile=None):
    links = []
    for n in profile_nodes(conf, profile or default_profile()):
        pw = urllib.parse.quote(user["password"], safe="")
        params = urllib.parse.urlencode({"sni": n["sni"], "fp": "chrome"})
        links.append(f"anytls://{pw}@{n['server']}:{n['port']}/?{params}#{urllib.parse.quote(n['name'])}")
    return base64.b64encode("\n".join(links).encode()).decode() + "\n"


# ---------- 订阅配置详情（控制台「配置」与 sbm user config 使用） ----------

SUB_FILES = {"singbox": "singbox.json", "clash": "clash.yaml", "uri": "uri.txt"}


def subscription_overview(conf, profile=None):
    """订阅的结构化概览：节点、代理组、分流规则（按匹配顺序）、DNS。
    与 build_singbox / build_clash 用同一份 group_plan，所以和实际下发的内容一致。"""
    profile = profile or default_profile()
    nodes = profile_nodes(conf, profile)
    regions, services = group_plan(nodes, profile)
    names = [n["name"] for n in nodes]
    region_titles = [r[0] for r in regions]
    rule_mode = profile["mode"] == "rule"
    main = main_choice(profile, regions, names)
    disp = lambda x: {"DIRECT": "直连", "REJECT": "拒绝"}.get(x, x)  # noqa: E731
    groups = [
        {"name": G_PROXY, "type": "手动选择", "default": main,
         "members": first_of(main, [G_AUTO, f"{G_FALLBACK}（仅 Clash）", *region_titles, *names, "直连"])},
        {"name": G_AUTO, "type": "自动测速", "default": "延迟最低", "members": names},
        {"name": G_FALLBACK, "type": "故障转移（仅 Clash）", "default": "第一个可用", "members": names},
        *[{"name": t, "type": "自动测速", "default": "延迟最低", "members": m} for t, m in regions],
        *[{"name": t, "type": "手动选择", "default": disp(o[0]), "members": [disp(x) for x in o]}
          for t, o, _gs, _gi in services],
    ]
    if profile["ads"]:
        groups.append({"name": G_ADS, "type": "手动选择（sing-box 固定拦截）", "default": "拦截", "members": ["拦截", "直连"]})
    if rule_mode:
        groups += [
            {"name": G_DIRECT, "type": "手动选择", "default": "直连", "members": ["直连", G_PROXY]},
            {"name": G_FINAL, "type": "手动选择", "default": G_PROXY,
             "members": [G_PROXY, "直连", G_AUTO, *region_titles, *names]},
        ]
    rules = [("局域网与私有地址（geosite:private、私有 IP）", "直连")]
    custom = custom_targets(profile, regions, names)
    rules += [(f"应用 · {APP_RULE_TYPES[r['type']]} {r['value']}" if r["type"] in APP_RULE_TYPES
               else f"自定义 · {RULE_TYPES[r['type']]} {r['value']}", disp(t)) for r, t in custom]
    if profile["ads"]:
        rules.append(("广告（geosite:category-ads-all）", G_ADS))
    for title, _options, geosite, geoip in services:
        rules.append(("、".join([f"geosite:{g}" for g in geosite] + [f"geoip:{g}" for g in geoip]), title))
    if rule_mode:
        rules += [("境外网站（geosite:geolocation-!cn）", G_PROXY),
                  ("国内网站与 IP（geosite:cn、geoip:cn）", G_DIRECT),
                  ("以上都没有匹配到", G_FINAL)]
        dns = [
            "sing-box：境外域名用 1.1.1.1（DoH）经「节点选择」解析；国内域名用 223.5.5.5（DoH）；"
            "列表外的域名先问国内 DNS，结果是国内 IP 才采用，否则改用境外 DNS",
            "Clash：fake-ip 模式；默认用阿里 / 腾讯 DoH，境外域名用 1.1.1.1（DoH）经「节点选择」解析；"
            "规则数据每 24 小时自动更新",
        ]
    else:
        rules.append(("其余全部流量（全局代理）", G_PROXY))
        dns = [
            "sing-box：除局域网域名外都用 1.1.1.1（DoH）经「节点选择」解析",
            "Clash：fake-ip 模式，域名交给节点解析；规则数据每 24 小时自动更新",
        ]
    if any(r["type"] in DOMAIN_RULE_TYPES for r, _t in custom):
        dns.append("sing-box：自定义规则里的域名，直连的用国内 DNS，走节点的用境外 DNS")
    return {
        "profile": {"id": profile.get("id", ""), "name": profile["name"], "mode": profile["mode"]},
        "nodes": [{"name": n["name"], "protocol": "AnyTLS", "server": n["server"], "port": n["port"],
                   "sni": n["sni"], "region": next((t for t, m in regions if n["name"] in m), "")}
                  for n in nodes],
        "groups": groups,
        "rules": [{"match": m, "target": t} for m, t in rules],
        "dns": dns,
        "rule_source": "MetaCubeX/meta-rules-dat（sing-box 用 .srs 规则集，Clash Meta 用同源 geosite / geoip）",
        "test_url": TEST_URL,
    }


def read_sub_files(user):
    """读取实际下发给客户端的订阅文件；停用的用户没有订阅文件，返回 None。"""
    d = os.path.join(WWW, user["token"])
    if not user["enabled"] or not os.path.isdir(d):
        return None
    files = {}
    for fmt, fname in SUB_FILES.items():
        try:
            with open(os.path.join(d, fname), encoding="utf-8") as f:
                files[fmt] = f.read()
        except FileNotFoundError:
            files[fmt] = ""
    return files


GUIDE_TPL = "/usr/local/share/sbm/guide.tpl.html"


def _qr_svg(text):
    try:
        import qrcode
        import qrcode.image.svg
    except ImportError:
        return ""
    img = qrcode.make(text, image_factory=qrcode.image.svg.SvgPathImage, box_size=10, border=2)
    return img.to_string(encoding="unicode")


def guide_groups(nodes, profile):
    """使用说明页第 4 步：按用户的配置说明各个分组，默认去向相同的服务组合并成一行。"""
    regions, services = group_plan(nodes, profile)
    main = main_choice(profile, regions, [n["name"] for n in nodes])
    if main == G_AUTO:
        out = [[G_PROXY, f"默认是 {G_AUTO}（自动用延迟最低的节点）。想固定用某个节点或某个地区，就在这里切换。"]]
    else:
        out = [[G_PROXY, f"默认是 {main}。想换成别的节点或地区，就在这里切换。"]]
    if profile["mode"] == "global":
        out.append(["🌐 全局代理", "除局域网地址外，所有流量都走节点，访问国内网站也会经过节点。"])
    buckets = {}
    for title, options, _gs, _gi in services:
        buckets.setdefault(options[0], []).append(title)
    ai = SERVICES[0][1]
    for first, titles in buckets.items():
        if first == G_PROXY:
            text = "默认跟随节点选择，也可以单独指定节点。"
        elif first == "DIRECT":
            text = "默认直连，速度更快；个别功能打不开时可以切到节点选择。"
        elif titles == [ai]:
            text = f"ChatGPT、Claude、Gemini 等默认走 {first}，避免地区限制。"
        else:
            text = f"默认走 {first}，也可以单独切换。"
        out.append([" / ".join(titles), text])
    if profile["custom_rules"]:
        out.append(["🧩 自定义规则", "管理员为部分网站设置了专门的分流方式，无需你操作。"])
    if profile.get("app_rules"):
        out.append(["📱 应用分流", "管理员为部分应用设置了专门的分流方式，无需你操作。iPhone 和 iPad 上不生效。"])
    if profile["ads"]:
        out.append([G_ADS, "默认拦截常见广告域名；如果某个网站因此打不开，可以切换为直连。"])
    if profile["mode"] == "rule":
        out.append([G_DIRECT, "国内网站和应用直连，不受影响。"])
    return out


def build_guide(conf, user, profile=None):
    """用户专属的使用说明页：下载、一键导入、操作步骤，与订阅放在同一个令牌目录下。"""
    profile = profile or default_profile()
    if not os.path.exists(GUIDE_TPL):
        return None
    base = f"https://{conf['sub_domain']}:{conf['sub_port']}"
    sub = f"{base}/s/{user['token']}"
    label = urllib.parse.quote(conf.get("profile_name", "sub"))
    links = {"universal": sub, "singbox": f"{sub}?t=singbox", "clash": f"{sub}?t=clash", "uri": f"{sub}?t=uri"}
    data = {
        "name": user["name"],
        "links": links,
        "imports": {
            "singbox": f"sing-box://import-remote-profile?url={urllib.parse.quote(links['singbox'], safe='')}#{label}",
            "clash": f"clash://install-config?url={urllib.parse.quote(links['clash'], safe='')}&name={label}",
            "shadowrocket": "shadowrocket://add/sub://" + base64.b64encode(links["uri"].encode()).decode() + f"?remark={label}",
            "hiddify": f"hiddify://import/{sub}#{label}",
        },
        "nodes": [n["name"] for n in profile_nodes(conf, profile)],
        "groups": guide_groups(profile_nodes(conf, profile), profile),
        "qr_guide": _qr_svg(f"{base}/u/{user['token']}"),
        "qr_sub": _qr_svg(sub),
    }
    with open(GUIDE_TPL, encoding="utf-8") as f:
        tpl = f.read()
    # 防止数据里的 </script> 提前结束脚本
    return tpl.replace("/*SBM_DATA*/null", json.dumps(data, ensure_ascii=False).replace("</", "<\\/"))


def build_subs(conf, users):
    os.makedirs(WWW, exist_ok=True)
    keep = set()
    profiles = load_profiles()
    for u in users:
        if not u["enabled"]:
            continue
        keep.add(u["token"])
        d = os.path.join(WWW, u["token"])
        os.makedirs(d, mode=0o755, exist_ok=True)
        profile = user_profile(u, profiles)
        write_file(f"{d}/singbox.json", json.dumps(build_singbox(conf, u, profile), indent=2, ensure_ascii=False) + "\n")
        write_file(f"{d}/clash.yaml", build_clash(conf, u, profile))
        write_file(f"{d}/uri.txt", build_uri(conf, u, profile))
        guide = build_guide(conf, u, profile)
        if guide:
            write_file(f"{d}/guide.html", guide)
    # 删除已删除、已停用或已重置用户的旧订阅目录
    for name in os.listdir(WWW):
        if name not in keep:
            shutil.rmtree(os.path.join(WWW, name), ignore_errors=True)


def sub_links(conf, user):
    base = f"https://{conf['sub_domain']}:{conf['sub_port']}/s/{user['token']}"
    return {
        "使用说明页（发给用户这一个就够）": f"https://{conf['sub_domain']}:{conf['sub_port']}/u/{user['token']}",
        "通用（按客户端自动识别）": base,
        "sing-box / Hiddify": f"{base}?t=singbox",
        "Clash Meta / Mihomo": f"{base}?t=clash",
        "Shadowrocket / 通用链接": f"{base}?t=uri",
        "sing-box 一键导入": "sing-box://import-remote-profile?url="
                             + urllib.parse.quote(f"{base}?t=singbox", safe="")
                             + "#" + urllib.parse.quote(conf.get("profile_name", "sub")),
    }


# ---------- 账号池与用户操作 ----------

CREDS = f"{ETC}/creds.json"
POOL_SIZE = 20


def load_creds():
    creds = load(CREDS, {})
    for key in ("spares", "retiring", "dirty"):
        creds.setdefault(key, [])
    return creds


def save_creds(creds):
    write_file(CREDS, json.dumps(creds, indent=2, ensure_ascii=False) + "\n", 0o600)


def pool_size(conf):
    return int(conf.get("pool_size", POOL_SIZE))


def pool_low(conf):
    """低水位：备用账号少于它时才补满。补充会改变节点上的账号集合（要重启节点），
    所以不是每次用掉一个就补，而是攒到一半再一次补齐，夜间重启次数大大减少。"""
    return int(conf.get("pool_low", max(1, pool_size(conf) // 2)))


def new_cred(password=None):
    return {"name": "s-" + secrets.token_hex(5), "password": password or rand(24)}


def node_credentials(users, creds):
    """节点上应有的全部账号：启用用户 + 备用账号 + 待清理账号。
    按账号名排序：集合不变时配置文件逐字节不变，push_node 判断为 UNCHANGED，节点不会重启。
    同时给还没有统计编号的账号分配编号（写入 creds["marks"]，调用方负责保存）。"""
    items = {u["cred"]: u["password"] for u in users if u["enabled"]}
    # 可达性探测专用账号（从账号池取出，见 probe_credential）也必须一直留在节点上
    for c in creds["spares"] + creds["retiring"] + ([creds["probe"]] if creds.get("probe") else []):
        items.setdefault(c["name"], c["password"])
    marks = creds.setdefault("marks", {})
    for name in sorted(items):
        if name not in marks:
            # 编号只增不复用，避免旧账号残留的计数被算到新账号头上
            creds["next_mark"] = creds.get("next_mark", 1)
            marks[name] = MARK_BASE + creds["next_mark"]
            creds["next_mark"] += 1
    return [{"name": k, "password": v} for k, v in sorted(items.items())]


def prune_marks(creds, cred_list):
    """维护清理账号后，去掉已不在节点上的账号编号。"""
    keep = {c["name"] for c in cred_list}
    creds["marks"] = {k: v for k, v in creds.get("marks", {}).items() if k in keep}


def get_user(users, name):
    for u in users:
        if u["name"] == name:
            return u
    raise SbmError(f"用户 {name} 不存在")


def pending_purge(creds, user):
    """停用的用户，其账号是否还留在节点上等待清理。"""
    return not user["enabled"] and any(r["name"] == user["cred"] for r in creds["retiring"])


def retire(creds, user, reason):
    """把启用用户的账号移到待清理列表：订阅立即失效，节点上的账号等维护时再删。"""
    if user["enabled"]:
        creds["retiring"].append({
            "name": user["cred"], "password": user["password"], "user": user["name"], "uid": user["id"],
            "reason": reason, "since": datetime.now().strftime("%Y-%m-%d %H:%M"),
        })


def assign_cred(creds, user, password=None):
    """给用户分配节点账号。优先用账号池里的（节点上已经有，不用重启）；
    池空了或指定了密码时新建一个，返回 True 表示需要推送节点。"""
    if creds["spares"] and not password:
        c, need_push = creds["spares"].pop(0), False
    else:
        c, need_push = new_cred(password), True
    user["cred"], user["password"] = c["name"], c["password"]
    return need_push


# 以下用户操作只修改内存中的 users / creds，返回 (是否需要推送节点, 给管理员的提示)；
# 由 commit() 统一保存并决定是否推送。

def user_add(users, creds, name, note="", password=None, profile=None):
    if not NAME_RE.match(name or ""):
        raise SbmError("用户名只能包含字母、数字、_ . -，最长 32 位")
    if any(u["name"] == name for u in users):
        raise SbmError(f"用户 {name} 已存在")
    u = {"id": secrets.token_hex(6), "name": name, "note": note, "token": rand(32), "enabled": True,
         "created": datetime.now().strftime("%Y-%m-%d %H:%M")}
    set_user_profile(u, load_profiles(), profile)
    need_push = assign_cred(creds, u, password)
    users.append(u)
    return need_push, ("账号池已用完，本次新建账号需要重启节点" if need_push and not password else "")


def user_delete(users, creds, name, now=False):
    u = get_user(users, name)
    retire(creds, u, "删除")
    users.remove(u)
    return now, "" if now else "订阅已失效；节点上的账号将在下次维护时清理"


def user_disable(users, creds, name, now=False):
    u = get_user(users, name)
    if not u["enabled"]:
        return now, ""
    retire(creds, u, "停用")
    u["enabled"] = False
    return now, "" if now else "订阅已失效；节点上的账号将在下次维护时清理"


def user_enable(users, creds, name):
    u = get_user(users, name)
    if u["enabled"]:
        return False, ""
    u["enabled"] = True
    for i, r in enumerate(creds["retiring"]):
        if r["name"] == u["cred"] and r["password"] == u["password"]:
            # 旧账号还没被清理，直接恢复，密码和订阅都不变
            creds["retiring"].pop(i)
            return False, ""
    need_push = assign_cred(creds, u)
    return need_push, "原账号已在节点上清理，已分配新密码：订阅链接不变，用户需要在客户端更新一次订阅"


def user_reset(users, creds, name, now=True):
    u = get_user(users, name)
    u["token"] = rand(32)
    if not u["enabled"]:
        # 停用的用户不占节点账号，重新启用时会分配
        return False, "已更换订阅链接"
    retire(creds, u, "重置")
    need_push = assign_cred(creds, u)
    return need_push or now, "" if now else "旧密码将在下次维护时失效"


def reconcile(conf, users, creds, log=print):
    """完整整理：清理待删除账号、补满账号池、推送到所有节点（只有配置变化的节点会重启）。"""
    target = pool_size(conf)
    # 先把各节点的计数收上来：待清理账号的最后一段流量要在它们被删之前记到用户名下
    try:
        collect(conf, users, creds, log=lambda *_: None)
    except Exception as e:  # noqa: BLE001 - 统计失败不能阻止推送账号
        log(f"⚠ 流量统计采集失败（不影响本次同步）: {e}")
    if len(creds["spares"]) < pool_low(conf):
        while len(creds["spares"]) < target:
            creds["spares"].append(new_cred())
    purged = len(creds["retiring"])
    creds["retiring"] = []
    cred_list = node_credentials(users, creds)
    if not cred_list:
        raise SbmError("没有任何账号可以推送")
    prune_marks(creds, cred_list)
    dirty = []
    for node in conf["nodes"]:
        success, msg = push_node(node, cred_list, creds["marks"])
        log(f"[{node['name']}] {'成功' if success else '失败'}: {msg}")
        if not success:
            dirty.append(node["name"])
    creds["dirty"] = dirty
    save_creds(creds)
    build_subs(conf, users)
    log(f"已清理 {purged} 个旧账号，账号池 {len(creds['spares'])}/{target}"
        + (f"；未同步成功: {', '.join(dirty)}（下次维护会重试）" if dirty else ""))
    return not dirty


def sync_prism(conf, users, creds, log=print):
    """Prism 热加载不断开其他用户，不用等维护：待清理账号立即从 Prism 节点上去掉（还在连接的会被断开）。
    sing-box 节点仍在维护时清理。推送失败的节点记入 dirty，下次维护重试。"""
    nodes = [n for n in conf["nodes"] if is_prism(n)]
    if not nodes:
        return
    active = {u["cred"] for u in users if u["enabled"]}
    retiring = {r["name"] for r in creds["retiring"]} - active
    cred_list = [c for c in node_credentials(users, creds) if c["name"] not in retiring]
    marks = creds["marks"]
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(lambda n: push_node(n, cred_list, marks), nodes))
    failed = [n["name"] for n, (success, _) in zip(nodes, results) if not success]
    for n, (success, msg) in zip(nodes, results):
        if not success:
            log(f"[{n['name']}] 同步账号失败: {msg}")
    dirty = [d for d in creds.get("dirty", []) if d not in {n["name"] for n in nodes}]
    creds["dirty"] = dirty + failed
    save_creds(creds)


def commit(conf, users, creds, need_push, log=print):
    save_users(users)
    if need_push:
        return reconcile(conf, users, creds, log)
    save_creds(creds)
    build_subs(conf, users)
    sync_prism(conf, users, creds, log)
    log("已生效，节点无需重启")
    return True


# ---------- 流量统计（采集与查询） ----------
# 每 5 分钟（sbm traffic collect，systemd 定时器）读取各节点计数器，算出增量，
# 按 日期 × 用户 id × 节点 累加到 SQLite。计数器变小视为被清零（节点重启、防火墙重载），按新值计。

TRAFFIC_DB = f"{ETC}/traffic.db"
USERINFO_MAP = "/etc/nginx/sbm-userinfo.map"
NODE_READ = "[ -x /usr/local/sbin/sbm-stats ] || exit 3; /usr/local/sbin/sbm-stats apply >/dev/null 2>&1; /usr/local/sbin/sbm-stats read"


def traffic_db():
    con = sqlite3.connect(TRAFFIC_DB, timeout=30)
    con.executescript("""
        CREATE TABLE IF NOT EXISTS last (node TEXT, fam TEXT, dir TEXT, mark INTEGER, bytes INTEGER,
                                         PRIMARY KEY (node, fam, dir, mark));
        CREATE TABLE IF NOT EXISTS usage (day TEXT, uid TEXT, node TEXT, up INTEGER DEFAULT 0, down INTEGER DEFAULT 0,
                                          PRIMARY KEY (day, uid, node));
        CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
    """)
    os.chmod(TRAFFIC_DB, 0o600)
    return con


def mark_owners(users, creds):
    """统计编号 → 用户 id。备用账号没有主人；已删除用户的待清理账号用记录里的 uid。"""
    marks = creds.get("marks", {})
    owners = {}
    for r in creds["retiring"]:
        if r["name"] in marks and r.get("uid"):
            owners[marks[r["name"]]] = r["uid"]
    for u in users:
        if u["cred"] in marks and (u["enabled"] or pending_purge(creds, u)):
            owners[marks[u["cred"]]] = u["id"]
    return owners


def _read_prism(node, marks):
    """Prism 内置按账号的累计流量（进程启动后累计，重启归零），转成和 iptables 计数相同的行，编号沿用账号的统计编号。"""
    r = ssh(node, f"prism-node-server stats -c {shlex.quote(node['config_path'])}")
    if r.returncode != 0:
        return node["name"], None, (r.stderr.strip() or "读取失败")[-200:]
    try:
        users = json.loads(r.stdout)["users"]
        return node["name"], [("app", d, marks[name], int(u[d])) for name, u in users.items() if name in marks
                              for d in ("up", "down")], ""
    except (ValueError, KeyError, TypeError) as e:
        return node["name"], None, f"统计数据无法解析: {e}"


def _read_node(node, marks=None):
    if is_prism(node):
        return _read_prism(node, marks or {})
    r = ssh(node, NODE_READ)
    if r.returncode == 3:
        return node["name"], None, "尚未启用统计"
    if r.returncode != 0:
        return node["name"], None, (r.stderr.strip() or "读取失败")[-200:]
    rows = []
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) == 4 and parts[1] in ("up", "down"):
            try:
                rows.append((parts[0], parts[1], int(parts[2], 16), int(parts[3])))
            except ValueError:
                pass
    return node["name"], rows, ""


def collect(conf, users=None, creds=None, log=print):
    """采集一次各节点的计数并入库。返回 {节点: 状态}。"""
    users = users if users is not None else load_users()
    creds = creds if creds is not None else load_creds()
    owners = mark_owners(users, creds)
    day = datetime.now().strftime("%Y-%m-%d")
    marks = creds.get("marks", {})
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(lambda n: _read_node(n, marks), conf["nodes"]))
    status = {}
    con = traffic_db()
    with con:
        for node_name, rows, err in results:
            if rows is None:
                status[node_name] = {"ok": False, "error": err}
                log(f"[{node_name}] {err}")
                continue
            added = 0
            for fam, direction, mark, value in rows:
                prev = con.execute("SELECT bytes FROM last WHERE node=? AND fam=? AND dir=? AND mark=?",
                                   (node_name, fam, direction, mark)).fetchone()
                delta = value if prev is None or value < prev[0] else value - prev[0]
                con.execute("INSERT OR REPLACE INTO last VALUES (?,?,?,?,?)", (node_name, fam, direction, mark, value))
                uid = owners.get(mark)
                if uid and delta:
                    col = "up" if direction == "up" else "down"
                    con.execute(f"INSERT INTO usage (day, uid, node, {col}) VALUES (?,?,?,?) "
                                f"ON CONFLICT (day, uid, node) DO UPDATE SET {col} = {col} + excluded.{col}",
                                (day, uid, node_name, delta))
                    added += delta
            status[node_name] = {"ok": True, "error": ""}
            log(f"[{node_name}] 新增 {fmt_bytes(added)}")
        con.execute("INSERT OR REPLACE INTO meta VALUES ('collected', ?)", (datetime.now().strftime("%Y-%m-%d %H:%M"),))
        con.execute("INSERT OR REPLACE INTO meta VALUES ('status', ?)", (json.dumps(status, ensure_ascii=False),))
    con.close()
    return status


def fmt_bytes(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.2f} {unit}"
        n /= 1024


def month_usage(con, month):
    """某月（YYYY-MM）每个用户的 (上传, 下载)。"""
    return {uid: (up, down) for uid, up, down in con.execute(
        "SELECT uid, SUM(up), SUM(down) FROM usage WHERE day LIKE ? GROUP BY uid", (month + "-%",))}


def traffic_summary(conf):
    """控制台首页需要的统计：本月每个用户、今日每个节点、本月合计、上次采集时间与各节点状态。"""
    if not os.path.exists(TRAFFIC_DB):
        return {"enabled": False, "users": {}, "nodes_today": {}, "month_total": [0, 0], "collected": "", "status": {}}
    con = traffic_db()
    today = datetime.now().strftime("%Y-%m-%d")
    users = {uid: [up, down] for uid, (up, down) in month_usage(con, today[:7]).items()}
    nodes = {n: [up, down] for n, up, down in con.execute(
        "SELECT node, SUM(up), SUM(down) FROM usage WHERE day = ? GROUP BY node", (today,))}
    meta = dict(con.execute("SELECT k, v FROM meta"))
    con.close()
    return {
        "enabled": True,
        "users": users,
        "nodes_today": nodes,
        "month_total": [sum(v[0] for v in users.values()), sum(v[1] for v in users.values())],
        "collected": meta.get("collected", ""),
        "status": json.loads(meta.get("status", "{}")),
    }


def traffic_detail(uid, days=30):
    """单个用户：最近 days 天每日流量、本月各节点分布、本月/上月/累计。"""
    con = traffic_db()
    today = datetime.now().date()
    start = (today - timedelta(days=days - 1)).isoformat()
    rows = {d: (up, down) for d, up, down in con.execute(
        "SELECT day, SUM(up), SUM(down) FROM usage WHERE uid = ? AND day >= ? GROUP BY day", (uid, start))}
    daily = []
    for i in range(days):
        d = (today - timedelta(days=days - 1 - i)).isoformat()
        up, down = rows.get(d, (0, 0))
        daily.append({"day": d, "up": up, "down": down})
    month = today.strftime("%Y-%m")
    last_month = (today.replace(day=1) - timedelta(days=1)).strftime("%Y-%m")
    by_node = [{"node": n, "up": up, "down": down} for n, up, down in con.execute(
        "SELECT node, SUM(up), SUM(down) FROM usage WHERE uid = ? AND day LIKE ? GROUP BY node ORDER BY SUM(up + down) DESC",
        (uid, month + "-%"))]

    def total(where, args):
        up, down = con.execute(f"SELECT COALESCE(SUM(up),0), COALESCE(SUM(down),0) FROM usage WHERE uid = ? {where}",
                               (uid, *args)).fetchone()
        return [up, down]
    result = {
        "daily": daily, "by_node": by_node,
        "month": total("AND day LIKE ?", (month + "-%",)),
        "last_month": total("AND day LIKE ?", (last_month + "-%",)),
        "all": total("", ()),
    }
    con.close()
    return result


def write_userinfo_map(conf, users):
    """生成 Nginx 的 token → subscription-userinfo 映射，客户端据此显示本月已用流量。
    内容有变化时返回 True（调用方负责重载 Nginx）。"""
    con = traffic_db()
    usage = month_usage(con, datetime.now().strftime("%Y-%m"))
    con.close()
    lines = []
    for u in users:
        if u["enabled"]:
            up, down = usage.get(u["id"], (0, 0))
            lines.append(f'{u["token"]} "upload={up}; download={down}; total=0; expire=0";\n')
    text = "".join(lines)
    try:
        with open(USERINFO_MAP, encoding="utf-8") as f:
            if f.read() == text:
                return False
    except FileNotFoundError:
        pass
    write_file(USERINFO_MAP, text, 0o644)
    return True


# ---------- 告警通知 ----------
# 渠道配置在 /etc/sbm/notify.json（仅 root 可读）；接口只返回打码后的信息，不返回 Webhook / Token 原文。
# 订阅服务器在国内连不上 Telegram，Telegram 消息经境外节点用 curl 转发（Token 通过标准输入传递，不出现在命令行里）。

NOTIFY = f"{ETC}/notify.json"
NOTIFY_TYPES = {"wecom": "企业微信", "feishu": "飞书", "dingtalk": "钉钉", "bark": "Bark", "telegram": "Telegram"}
URL_PREFIX = {
    "wecom": ("https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=",),
    "feishu": ("https://open.feishu.cn/open-apis/bot/v2/hook/", "https://open.larksuite.com/open-apis/bot/v2/hook/"),
    "dingtalk": ("https://oapi.dingtalk.com/robot/send?access_token=",),
    "bark": ("https://",),
}


def write_private(path, text):
    """以 600 权限创建临时文件再替换，内容任何时候都不会被其他用户读到。"""
    tmp = f"{path}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def load_notify():
    data = load(NOTIFY, {})
    data.setdefault("channels", [])
    return data


def save_notify(data):
    write_private(NOTIFY, json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def mask_channel(ch):
    """给界面显示用：只露出主机名和末尾几位。"""
    tail = lambda s: ("…" + s[-4:]) if s else ""  # noqa: E731
    if ch["type"] == "telegram":
        target = f"Bot {tail(ch.get('token', ''))} → {ch.get('chat_id', '')}"
    else:
        target = f"{urllib.parse.urlparse(ch.get('url', '')).hostname} {tail(ch.get('url', ''))}"
    return {"id": ch["id"], "type": ch["type"], "type_name": NOTIFY_TYPES[ch["type"]], "name": ch.get("name", ""),
            "enabled": ch.get("enabled", True), "target": target, "signed": bool(ch.get("secret"))}


def notify_add(data, ctype, name="", url="", secret="", token="", chat_id=""):
    if ctype not in NOTIFY_TYPES:
        raise SbmError("不支持的通知类型")
    ch = {"id": secrets.token_hex(4), "type": ctype, "name": (name or NOTIFY_TYPES[ctype]).strip()[:32], "enabled": True}
    if ctype == "telegram":
        token, chat_id = (token or "").strip(), (chat_id or "").strip()
        if not re.fullmatch(r"\d{5,}:[A-Za-z0-9_-]{30,}", token):
            raise SbmError("Bot Token 格式不对，应为 BotFather 给出的 数字:字母串")
        if not re.fullmatch(r"-?\d{3,}|@[A-Za-z0-9_]{4,}", chat_id):
            raise SbmError("Chat ID 格式不对（数字，群组为负数；或 @频道名）")
        ch.update(token=token, chat_id=chat_id)
    else:
        url = (url or "").strip()
        if not url.startswith(URL_PREFIX[ctype]) or len(url) > 500 or any(c in url for c in " \n\"'"):
            raise SbmError(f"{NOTIFY_TYPES[ctype]} 地址格式不对，应以 {URL_PREFIX[ctype][0]} 开头")
        ch["url"] = url
        if secret and ctype in ("feishu", "dingtalk"):
            ch["secret"] = secret.strip()
    data["channels"].append(ch)
    return ch


def _post_json(url, payload):
    req = urllib.request.Request(url, data=json.dumps(payload, ensure_ascii=False).encode(), method="POST",
                                 headers={"Content-Type": "application/json; charset=utf-8", "User-Agent": "sbm"})
    try:
        with urllib.request.urlopen(req, timeout=12) as resp:
            body = resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
    except (urllib.error.URLError, OSError) as e:
        raise SbmError(f"连接失败: {e}")
    try:
        return json.loads(body)
    except ValueError:
        return {"raw": body[:200]}


def _telegram_api(conf, token, method, fields):
    """经境外节点调用 Telegram Bot API。Token 和内容放在 curl 的 -K 配置里，从标准输入传入。"""
    esc = lambda s: str(s).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")  # noqa: E731
    cfg = f'url = "https://api.telegram.org/bot{esc(token)}/{method}"\n'
    cfg += "".join(f'data-urlencode = "{esc(k)}={esc(v)}"\n' for k, v in fields.items())
    last = "没有可用的节点做转发"
    for node in conf["nodes"]:
        r = ssh(node, "curl -s --max-time 15 -K -", stdin=cfg)
        if r.returncode == 0 and r.stdout.strip():
            try:
                return json.loads(r.stdout)
            except ValueError:
                last = r.stdout.strip()[:200]
        else:
            last = (r.stderr or r.stdout).strip()[:200] or f"经 {node['name']} 转发失败"
    raise SbmError(f"Telegram 请求失败: {last}")


def telegram_chat_id(conf, token):
    """读取机器人最近收到的消息，找出发消息的聊天 ID（先在 Telegram 里给机器人发一句话）。"""
    if not re.fullmatch(r"\d{5,}:[A-Za-z0-9_-]{30,}", (token or "").strip()):
        raise SbmError("Bot Token 格式不对")
    data = _telegram_api(conf, token.strip(), "getUpdates", {})
    if not data.get("ok"):
        raise SbmError(f"Telegram 返回错误: {data.get('description', data)}")
    for upd in reversed(data.get("result", [])):
        for key in ("message", "channel_post", "my_chat_member", "edited_message"):
            chat = (upd.get(key) or {}).get("chat")
            if chat:
                return {"chat_id": str(chat["id"]), "title": chat.get("title") or chat.get("username") or chat.get("first_name", "")}
    raise SbmError("机器人还没有收到任何消息：请先在 Telegram 里给机器人发一句话（群组里则 @ 它一次），再点获取")


def send_channel(conf, ch, title, text):
    """发送一条通知，成功返回 None，失败抛出 SbmError。消息里都带有 sbm 字样，便于钉钉「关键词」安全设置。"""
    content = f"{title}\n{text}"
    t = ch["type"]
    if t == "telegram":
        r = _telegram_api(conf, ch["token"], "sendMessage", {"chat_id": ch["chat_id"], "text": content})
        if not r.get("ok"):
            raise SbmError(f"Telegram 返回错误: {r.get('description', r)}")
        return
    url = ch["url"]
    if t == "wecom":
        r = _post_json(url, {"msgtype": "text", "text": {"content": content}})
        ok = r.get("errcode") == 0
    elif t == "dingtalk":
        if ch.get("secret"):
            ts = str(int(time.time() * 1000))
            sign = base64.b64encode(hmac.new(ch["secret"].encode(), f"{ts}\n{ch['secret']}".encode(), hashlib.sha256).digest())
            url += f"&timestamp={ts}&sign={urllib.parse.quote_plus(sign.decode())}"
        r = _post_json(url, {"msgtype": "text", "text": {"content": content}})
        ok = r.get("errcode") == 0
    elif t == "feishu":
        payload = {"msg_type": "text", "content": {"text": content}}
        if ch.get("secret"):
            ts = str(int(time.time()))
            payload["timestamp"] = ts
            payload["sign"] = base64.b64encode(hmac.new(f"{ts}\n{ch['secret']}".encode(), b"", hashlib.sha256).digest()).decode()
        r = _post_json(url, payload)
        ok = r.get("code", r.get("StatusCode")) == 0
    else:  # bark：地址形如 https://api.day.app/<key>
        r = _post_json(url.rstrip("/"), {"title": title, "body": text, "group": "sbm"})
        ok = r.get("code") == 200
    if not ok:
        raise SbmError(f"{NOTIFY_TYPES[t]} 返回错误: {r.get('errmsg') or r.get('msg') or r.get('message') or r}")


ALERTS = f"{ETC}/alerts.json"
ALERT_HISTORY_KEEP = 200


@contextlib.contextmanager
def alerts_locked():
    """告警状态单独一把锁：探测、健康检查、备份可能同时发告警，又不想占用用户操作的大锁。"""
    with open(f"{ETC}/.alerts.lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def notify_all(conf, title, text, log=print):
    """发到所有启用的渠道，并记入告警历史（没有渠道时也记录，控制台能看到本该发出的内容）。
    返回 [(渠道名, 错误或 None)]。"""
    results = []
    for ch in load_notify()["channels"]:
        if not ch.get("enabled", True):
            continue
        try:
            send_channel(conf, ch, title, text)
            results.append((ch["name"], None))
        except SbmError as e:
            results.append((ch["name"], str(e)))
            log(f"通知发送失败 [{ch['name']}]: {e}")
    with alerts_locked():
        st = load(ALERTS, {})
        hist = st.setdefault("history", [])
        hist.append({"ts": int(time.time()), "title": title, "text": text,
                     "sent": [n for n, e in results if not e], "failed": [n for n, e in results if e]})
        st["history"] = hist[-ALERT_HISTORY_KEEP:]
        write_private(ALERTS, json.dumps(st, ensure_ascii=False, indent=1) + "\n")
    return results


def alert(conf, key, active, title, text, recover=None, need=1, repeat=6 * 3600, log=print):
    """有状态的告警：
    active 连续出现 need 次后发出；持续期间每 repeat 秒提醒一次；
    恢复（active 为假）时如果之前发过告警，发送 recover=(标题, 正文)。"""
    now = int(time.time())
    fire = recovered = False
    with alerts_locked():
        st = load(ALERTS, {})
        act, cnt = st.setdefault("active", {}), st.setdefault("count", {})
        if active:
            cnt[key] = cnt.get(key, 0) + 1
            a = act.get(key)
            if cnt[key] >= need and (not a or now - a["last"] >= repeat):
                act[key] = {"since": (a or {}).get("since", now), "last": now, "title": title}
                fire = True
        else:
            cnt.pop(key, None)
            recovered = act.pop(key, None) is not None
        write_private(ALERTS, json.dumps(st, ensure_ascii=False, indent=1) + "\n")
    if fire:
        notify_all(conf, title, text, log)
    elif recovered and recover:
        notify_all(conf, recover[0], recover[1], log)


# ---------- 国内可达性探测 ----------
# 订阅服务器在国内，正好用来检测各节点从国内能否访问。每 5 分钟（sbm probe run）依次做：
#   DNS：用国内 DNS 解析节点域名，看是否得到节点真实 IP（检测域名污染）
#   TCP / TLS：直连节点 IP，测握手延迟；TLS 带节点域名做 SNI 并校验证书（检测 IP 封锁、SNI 阻断）
#   代理：本机临时运行 sing-box 客户端，经每个节点真实代理一次请求（最可靠，能发现协议被识别阻断）
#   境外对照：国内检测失败时，让另一台节点去连它，区分「从国内被封」和「节点本身故障」
# 连续 2 轮异常才告警，异常期间每 6 小时提醒一次，恢复时再通知。

PROBE_DB = f"{ETC}/probe.db"
SB_BIN = f"{ETC}/bin/sing-box"
PROBE_URL = "https://www.gstatic.com/generate_204"
CN_DNS = "223.5.5.5"
PROBE_STATUS = {
    "ok": "正常", "dns": "域名解析异常（疑似 DNS 污染）", "blocked": "疑似被封（境外可连，国内不通）",
    "down": "节点故障（国内外都连不上）", "unreachable": "国内无法访问", "proxy_fail": "代理不通（TLS 正常）",
}
ALERT_AFTER = 2          # 连续几轮异常才告警
ALERT_REPEAT = 6 * 3600  # 持续异常时的提醒间隔（秒）


def probe_db():
    con = sqlite3.connect(PROBE_DB, timeout=30)
    con.executescript("""
        CREATE TABLE IF NOT EXISTS probe (ts INTEGER, node TEXT, status TEXT, dns TEXT, tcp_ms INTEGER, tls_ms INTEGER,
                                          proxy_ms INTEGER, outside TEXT, detail TEXT);
        CREATE INDEX IF NOT EXISTS probe_node_ts ON probe (node, ts);
        CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
    """)
    if "cert_days" not in [c[1] for c in con.execute("PRAGMA table_info(probe)")]:
        con.execute("ALTER TABLE probe ADD COLUMN cert_days INTEGER")  # 旧库升级
    os.chmod(PROBE_DB, 0o600)
    return con


def dns_a(domain, server=CN_DNS, timeout=5):
    """最简单的 UDP DNS A 记录查询，返回 IP 列表。"""
    q = struct.pack(">HHHHHH", secrets.randbelow(65536), 0x0100, 1, 0, 0, 0)
    q += b"".join(bytes([len(p)]) + p.encode() for p in domain.split(".")) + b"\x00" + struct.pack(">HH", 1, 1)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(timeout)
        s.sendto(q, (server, 53))
        data, _ = s.recvfrom(4096)
    count, i, ips = struct.unpack(">H", data[6:8])[0], 12, []
    while data[i]:
        i += data[i] + 1
    i += 5
    for _ in range(count):
        if data[i] & 0xC0 == 0xC0:
            i += 2
        else:
            while data[i]:
                i += data[i] + 1
            i += 1
        rtype, _cls, _ttl, length = struct.unpack(">HHIH", data[i:i + 10])
        i += 10
        if rtype == 1:
            ips.append(socket.inet_ntoa(data[i:i + length]))
        i += length
    return ips


def node_ip(node):
    try:
        ipaddress.ip_address(node["host"])
        return node["host"]
    except ValueError:
        return socket.gethostbyname(node["host"])


def _local_checks(node):
    """DNS / TCP / TLS 三项，在订阅服务器上直接做。"""
    res = {"dns": "fail", "tcp_ms": None, "tls_ms": None, "cert_days": None, "err": []}
    try:
        ip = node_ip(node)
    except OSError as e:
        res["err"].append(f"解析节点地址失败: {e}")
        return res
    try:
        ips = dns_a(node["server"])
        res["dns"] = "ok" if ip in ips else ("mismatch" if ips else "empty")
        if res["dns"] != "ok":
            res["err"].append(f"国内 DNS 解析 {node['server']} 得到 {', '.join(ips) or '空结果'}，节点 IP 是 {ip}")
    except OSError as e:
        res["err"].append(f"国内 DNS 查询失败: {e}")
    t0 = time.monotonic()
    try:
        with socket.create_connection((ip, node["port"]), timeout=5):
            res["tcp_ms"] = int((time.monotonic() - t0) * 1000)
    except OSError as e:
        res["err"].append(f"TCP 连接失败: {e}")
        return res
    t0 = time.monotonic()
    try:
        ctx = ssl.create_default_context()
        with socket.create_connection((ip, node["port"]), timeout=6) as raw:
            with ctx.wrap_socket(raw, server_hostname=node["sni"]) as tls:
                res["tls_ms"] = int((time.monotonic() - t0) * 1000)
                # 节点实际出示的证书还剩几天（包括节点自己续期的「接入」节点）
                not_after = tls.getpeercert().get("notAfter")
                if not_after:
                    res["cert_days"] = int((ssl.cert_time_to_seconds(not_after) - time.time()) // 86400)
    except (OSError, ssl.SSLError) as e:
        res["err"].append(f"TLS 握手失败: {e}")
    return res


def probe_credential():
    """探测专用账号：从账号池里取一个（它本来就在所有节点上，不需要重启节点）。"""
    with locked():
        creds = load_creds()
        if not creds.get("probe") and creds["spares"]:
            creds["probe"] = creds["spares"].pop()
            save_creds(creds)
        return creds.get("probe")


def download_singbox(conf):
    """全是 Prism 节点时没有 sing-box 可以复制，下载官方版本。下载失败不影响其他检测项，每小时最多重试一次。"""
    arch = PRISM_ARCH.get(os.uname().machine)
    tried = f"{SB_BIN}.tried"
    if not arch or (os.path.exists(tried) and time.time() - os.path.getmtime(tried) < 3600):
        return None
    write_file(tried, "", 0o600)
    try:
        ver = releases(kernel="sing-box")["latest"]
        name = f"sing-box-{ver}-linux-{arch}"
        data = fetch_url(conf, f"https://github.com/{KERNELS['sing-box']['repo']}/releases/download/v{ver}/{name}.tar.gz")
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
            binary = tar.extractfile(f"{name}/sing-box").read()
    except (OSError, SbmError, KeyError, tarfile.TarError) as e:
        print(f"下载 sing-box 失败，本次不检测代理: {e}", file=sys.stderr)
        return None
    return binary


def ensure_singbox_bin(conf):
    """本机做代理检测用的 sing-box：没有时从 sing-box 节点复制一份（节点与订阅服务器同为 x86_64 Linux），
    没有这样的节点就下载。"""
    if os.access(SB_BIN, os.X_OK):
        return SB_BIN
    os.makedirs(os.path.dirname(SB_BIN), mode=0o700, exist_ok=True)

    def install(binary):
        with open(f"{SB_BIN}.tmp", "wb") as f:
            f.write(binary)
        os.chmod(f"{SB_BIN}.tmp", 0o700)
        if subprocess.run([f"{SB_BIN}.tmp", "version"], capture_output=True).returncode == 0:
            os.replace(f"{SB_BIN}.tmp", SB_BIN)
            return True
        return False

    for node in conf["nodes"]:
        if is_prism(node):
            continue
        args = ["ssh", "-i", node["ssh_key"], "-p", str(node.get("ssh_port", 22)), "-o", "BatchMode=yes",
                "-o", "ConnectTimeout=10", f"{node['ssh_user']}@{node['host']}", "cat $(command -v sing-box)"]
        r = subprocess.run(args, capture_output=True, stdin=subprocess.DEVNULL)
        if r.returncode == 0 and r.stdout[:4] == b"\x7fELF" and install(r.stdout):
            return SB_BIN
    binary = download_singbox(conf)
    return SB_BIN if binary and install(binary) else None


def _proxy_checks(conf, cred, sb_bin):
    """本机临时运行 sing-box：每个节点一个本地入口，经节点真实请求一次，返回 {节点: (毫秒或 None, 错误)}。"""
    nodes = conf["nodes"]
    base = 31000 + secrets.randbelow(2000)
    cfg = {
        "log": {"level": "error"},
        "dns": {"servers": [{"type": "udp", "tag": "cn", "server": CN_DNS}]},
        "inbounds": [{"type": "mixed", "tag": f"in{i}", "listen": "127.0.0.1", "listen_port": base + i}
                     for i in range(len(nodes))],
        "outbounds": [dict(outbound_singbox(n, {"password": cred["password"]}), tag=f"out{i}") for i, n in enumerate(nodes)]
        + [{"type": "direct", "tag": "direct"}],
        "route": {"rules": [{"inbound": [f"in{i}"], "outbound": f"out{i}"} for i in range(len(nodes))],
                  "default_domain_resolver": "cn"},
    }
    tmp = tempfile.mkdtemp(prefix="sbm-probe-")
    path = os.path.join(tmp, "probe.json")
    write_private(path, json.dumps(cfg))
    proc = subprocess.Popen([sb_bin, "run", "-c", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    results = {}
    try:
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline:  # 等本地入口全部就绪
            try:
                with socket.create_connection(("127.0.0.1", base + len(nodes) - 1), timeout=0.5):
                    break
            except OSError:
                time.sleep(0.2)

        def one(i):
            r = subprocess.run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code} %{time_total}", "--max-time", "12",
                                "-x", f"socks5h://127.0.0.1:{base + i}", PROBE_URL], capture_output=True, text=True)
            code, _, secs = r.stdout.partition(" ")
            if code == "204":
                return nodes[i]["name"], (int(float(secs) * 1000), "")
            return nodes[i]["name"], (None, f"代理请求失败（HTTP {code or '无响应'}，curl {r.returncode}）")
        with ThreadPoolExecutor(max_workers=8) as pool:
            results = dict(pool.map(one, range(len(nodes))))
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        shutil.rmtree(tmp, ignore_errors=True)
    return results


def _outside_check(conf, target):
    """让另一台节点从境外连目标节点（TLS 握手 + 证书校验），区分被墙和节点故障。"""
    ip, port, sni = node_ip(target), target["port"], target["sni"]
    cmd = (f"timeout 10 openssl s_client -connect {shlex.quote(ip)}:{int(port)} -servername {shlex.quote(sni)} "
           "-verify_return_error </dev/null >/dev/null 2>&1 && echo OK || echo FAIL")
    for node in conf["nodes"]:
        if node["name"] == target["name"]:
            continue
        r = ssh(node, cmd)
        if r.returncode == 0 and r.stdout.strip() in ("OK", "FAIL"):
            return "ok" if r.stdout.strip() == "OK" else "fail", node["name"]
    return "n/a", ""


def _classify(local, proxy, outside):
    proxy_ms, _ = proxy if proxy else (None, "")
    if proxy_ms is not None:
        return "ok"
    if proxy is None and local["tls_ms"] is not None:  # 还没有代理检测条件时，以 TLS 为准
        return "ok"
    if local["tcp_ms"] is None or local["tls_ms"] is None:
        return {"ok": "blocked", "fail": "down"}.get(outside, "unreachable")
    if local["dns"] in ("mismatch", "empty"):
        return "dns"
    return "proxy_fail"


def probe_run(conf, log=print):
    """检测所有节点一次，入库、按需告警，返回每个节点的结果。"""
    nodes = conf["nodes"]
    if not nodes:
        return {}
    cred, sb_bin = probe_credential(), ensure_singbox_bin(conf)
    with ThreadPoolExecutor(max_workers=8) as pool:
        local = dict(zip([n["name"] for n in nodes], pool.map(_local_checks, nodes)))
    proxy = _proxy_checks(conf, cred, sb_bin) if cred and sb_bin else {}
    now = int(time.time())
    results = {}
    for n in nodes:
        name, loc, px = n["name"], local[n["name"]], proxy.get(n["name"])
        outside, via = ("", "")
        if (px is None or px[0] is None) and (loc["tcp_ms"] is None or loc["tls_ms"] is None):
            outside, via = _outside_check(conf, n)
        status = _classify(loc, px, outside)
        detail = loc["err"] + ([px[1]] if px and px[1] else [])
        if outside:
            detail.append(f"境外对照（经 {via}）：{'可以连接' if outside == 'ok' else '也连不上' if outside == 'fail' else '无可用对照节点'}")
        results[name] = {"status": status, "label": PROBE_STATUS[status], "dns": loc["dns"], "tcp_ms": loc["tcp_ms"],
                         "tls_ms": loc["tls_ms"], "proxy_ms": px[0] if px else None, "outside": outside,
                         "detail": detail, "proxy_tested": bool(px), "cert_days": loc["cert_days"]}
        log(f"[{name}] {PROBE_STATUS[status]}  TCP {loc['tcp_ms']} ms  TLS {loc['tls_ms']} ms  "
            f"代理 {px[0] if px else '未测'} ms" + (f"  ({'；'.join(detail)})" if detail else ""))
    con = probe_db()
    with con:
        for name, r in results.items():
            con.execute("INSERT INTO probe (ts, node, status, dns, tcp_ms, tls_ms, proxy_ms, outside, detail, cert_days) "
                        "VALUES (?,?,?,?,?,?,?,?,?,?)",
                        (now, name, r["status"], r["dns"], r["tcp_ms"], r["tls_ms"], r["proxy_ms"], r["outside"],
                         json.dumps(r["detail"], ensure_ascii=False), r["cert_days"]))
        con.execute("DELETE FROM probe WHERE ts < ?", (now - 14 * 86400,))
        state = json.loads((con.execute("SELECT v FROM meta WHERE k='state'").fetchone() or ["{}"])[0])
        alerts = []  # 先记下来，提交数据库之后再发，避免慢的通知占着数据库
        for name, r in results.items():
            st = state.get(name, {"fails": 0, "alerted": 0, "since": now})
            if r["status"] == "ok":
                if st.get("alerted"):
                    alerts.append((f"🟢 sbm 节点恢复：{name}",
                                   f"{name} 已恢复，国内访问正常（代理延迟 {r['proxy_ms']} ms）。\n"
                                   f"异常持续了约 {max(1, (now - st['since']) // 60)} 分钟。"))
                st = {"fails": 0, "alerted": 0, "since": now}
            else:
                st["since"] = st["since"] if st["fails"] else now
                st["fails"] += 1
                if st["fails"] >= ALERT_AFTER and now - st.get("alerted", 0) >= ALERT_REPEAT:
                    alerts.append((f"🔴 sbm 节点异常：{name}",
                                   f"{r['label']}\n" + "\n".join(f"· {d}" for d in r["detail"])
                                   + f"\n已持续约 {max(1, (now - st['since']) // 60)} 分钟。"))
                    st["alerted"] = now
            state[name] = st
        state = {k: v for k, v in state.items() if k in results}
        con.execute("INSERT OR REPLACE INTO meta VALUES ('state', ?)", (json.dumps(state),))
        con.execute("INSERT OR REPLACE INTO meta VALUES ('last_run', ?)", (str(now),))
    con.close()
    for title, text in alerts:
        notify_all(conf, title, text, log)
    return results


def probe_summary(conf):
    """每个节点最近一次结果 + 最近 24 小时可用率、平均代理延迟。"""
    if not os.path.exists(PROBE_DB):
        return {"enabled": False, "nodes": {}, "last_run": None}
    con = probe_db()
    since = int(time.time()) - 86400
    out = {}
    for n in conf["nodes"]:
        row = con.execute("SELECT ts, status, dns, tcp_ms, tls_ms, proxy_ms, outside, detail, cert_days FROM probe "
                          "WHERE node=? ORDER BY ts DESC LIMIT 1", (n["name"],)).fetchone()
        if not row:
            continue
        total, good, avg = con.execute("SELECT COUNT(*), SUM(status='ok'), AVG(CASE WHEN status='ok' THEN proxy_ms END) "
                                       "FROM probe WHERE node=? AND ts>=?", (n["name"], since)).fetchone()
        out[n["name"]] = {"ts": row[0], "status": row[1], "label": PROBE_STATUS.get(row[1], row[1]), "dns": row[2],
                          "tcp_ms": row[3], "tls_ms": row[4], "proxy_ms": row[5], "outside": row[6],
                          "detail": json.loads(row[7] or "[]"), "cert_days": row[8],
                          "uptime_24h": round(100 * (good or 0) / total, 1) if total else None,
                          "avg_proxy_ms": int(avg) if avg else None, "samples_24h": total}
    last = con.execute("SELECT v FROM meta WHERE k='last_run'").fetchone()
    con.close()
    return {"enabled": True, "nodes": out, "last_run": int(last[0]) if last else None}


def probe_history(node_name, hours=24):
    con = probe_db()
    rows = con.execute("SELECT ts, status, tcp_ms, tls_ms, proxy_ms, detail FROM probe WHERE node=? AND ts>=? ORDER BY ts",
                       (node_name, int(time.time()) - hours * 3600)).fetchall()
    con.close()
    return [{"ts": r[0], "status": r[1], "label": PROBE_STATUS.get(r[1], r[1]), "tcp_ms": r[2], "tls_ms": r[3],
             "proxy_ms": r[4], "detail": json.loads(r[5] or "[]")} for r in rows]


# ---------- 备份 ----------
# 每天 03:30（sbm-backup.timer）打包配置、用户、账号池、证书与 Token、管理密钥和统计库，本机保留 14 份；
# 再用 AES-256 加密后复制一份到境外节点（/root/sbm-backups）。备份里有全部密钥，所以异地副本必须加密；
# 解密密钥只在订阅服务器上（/etc/sbm/backup.key），需要管理员另行保存，否则订阅服务器丢失时无法解密。

BACKUP_DIR = "/var/backups/sbm"
BACKUP_KEY = f"{ETC}/backup.key"
BACKUP_STATE = f"{ETC}/backup.json"
BACKUP_KEEP = 14
BACKUP_RE = re.compile(r"^sbm-\d{8}-\d{6}\.tar\.gz$")
OFFSITE_DIR = "/root/sbm-backups"


def backup_key():
    if not os.path.exists(BACKUP_KEY):
        write_private(BACKUP_KEY, secrets.token_urlsafe(32) + "\n")
    with open(BACKUP_KEY, encoding="utf-8") as f:
        return f.read().strip()


def _backup_paths():
    fixed = ["etc/sbm", "etc/letsencrypt", "root/.ssh/sbm_node", "root/.ssh/sbm_node.pub",
             "etc/nginx/sbm-admin.htpasswd", "etc/nginx/sites-available/sub.conf",
             "usr/local/bin/sbm", "opt/sbm-web", "usr/local/share/sbm"]
    units = sorted(p[1:] for p in glob.glob("/etc/systemd/system/sbm-*"))
    return [p for p in fixed + units if os.path.exists("/" + p)]


def backup_run(conf, log=print):
    """做一次备份并复制到异地，返回状态。失败时告警。"""
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    backup_key()
    now = int(time.time())
    name = f"sbm-{datetime.now():%Y%m%d-%H%M%S}.tar.gz"
    out = os.path.join(BACKUP_DIR, name)
    tmp = tempfile.mkdtemp(prefix="sbm-backup-")
    state = load(BACKUP_STATE, {})
    error = ""
    try:
        # SQLite 正在写入时直接打包可能得到损坏的文件，先用在线备份接口取一致的快照
        snap = os.path.join(tmp, "snap")
        os.makedirs(os.path.join(snap, "etc/sbm"))
        dbs = [f for f in ("traffic.db", "probe.db") if os.path.exists(f"{ETC}/{f}")]
        for f in dbs:
            src, dst = sqlite3.connect(f"{ETC}/{f}", timeout=30), sqlite3.connect(os.path.join(snap, "etc/sbm", f))
            src.backup(dst)
            dst.close()
            src.close()
        # 用 tarfile 而不是 tar 命令：tar 的 --exclude 会连同后面以同名加入的快照一起排除掉
        skip = {f"etc/sbm/{f}" for f in dbs}

        def keep(info):
            n = info.name
            if n == "etc/sbm/bin" or n.startswith("etc/sbm/bin/") or n in skip or n.endswith((".tmp", ".part")) \
                    or os.path.basename(n).endswith(".lock"):
                return None
            return info
        old = os.umask(0o077)
        try:
            with tarfile.open(out + ".part", "w:gz") as tar:
                for p in _backup_paths():
                    tar.add("/" + p, arcname=p, filter=keep)
                for f in dbs:  # 一致性快照放回原来的位置
                    tar.add(os.path.join(snap, "etc/sbm", f), arcname=f"etc/sbm/{f}")
        except (OSError, tarfile.TarError) as e:
            raise SbmError(f"打包失败: {e}")
        finally:
            os.umask(old)
        os.replace(out + ".part", out)
        size = os.path.getsize(out)
        for f in sorted(f for f in os.listdir(BACKUP_DIR) if BACKUP_RE.match(f))[:-BACKUP_KEEP]:
            os.remove(os.path.join(BACKUP_DIR, f))
        state.update(last_ok=now, last_file=name, last_size=size)
        log(f"本机备份完成: {out}（{fmt_bytes(size)}）")
        # 异地副本：加密后经 SSH 复制到第一台可连接的节点
        enc = os.path.join(tmp, name + ".enc")
        r = subprocess.run(["openssl", "enc", "-aes-256-cbc", "-pbkdf2", "-iter", "200000", "-salt",
                            "-in", out, "-out", enc, "-pass", f"file:{BACKUP_KEY}"], capture_output=True, text=True)
        if r.returncode != 0:
            raise SbmError(f"加密失败: {r.stderr.strip()[-300:]}")
        with open(enc, "rb") as f:
            data = f.read()
        offsite = {"ok": False, "ts": now, "node": "", "file": name + ".enc", "error": "没有可用的节点"}
        cmd = (f"mkdir -p {OFFSITE_DIR} && chmod 700 {OFFSITE_DIR} && cat > {OFFSITE_DIR}/{name}.enc.part"
               f" && mv {OFFSITE_DIR}/{name}.enc.part {OFFSITE_DIR}/{name}.enc"
               f" && ls -1t {OFFSITE_DIR}/sbm-*.tar.gz.enc | tail -n +{BACKUP_KEEP + 1} | xargs -r rm -f && echo OK")
        for node in conf["nodes"]:
            args = ["ssh", "-i", node["ssh_key"], "-p", str(node.get("ssh_port", 22)), "-o", "BatchMode=yes",
                    "-o", "ConnectTimeout=10", f"{node['ssh_user']}@{node['host']}", cmd]
            rr = subprocess.run(args, input=data, capture_output=True)
            if rr.returncode == 0 and b"OK" in rr.stdout:
                offsite.update(ok=True, node=node["name"], error="")
                log(f"异地副本已加密保存到 {node['name']}:{OFFSITE_DIR}/{name}.enc")
                break
            offsite["error"] = rr.stderr.decode("utf-8", "replace").strip()[-200:] or f"复制到 {node['name']} 失败"
        state["offsite"] = offsite
        if not offsite["ok"]:
            log(f"⚠ 异地副本失败: {offsite['error']}")
    except (SbmError, OSError, sqlite3.Error) as e:
        error = str(e)
        state.update(last_fail=now, last_error=error)
        log(f"✗ 备份失败: {error}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
        if os.path.exists(out + ".part"):
            os.remove(out + ".part")
        state["last_run"] = now
        write_private(BACKUP_STATE, json.dumps(state, ensure_ascii=False, indent=1) + "\n")
    alert(conf, "backup:fail", bool(error), "🔴 sbm 备份失败", f"{error}\n本机已有的备份不受影响，请尽快处理。",
          recover=("🟢 sbm 备份恢复正常", f"最新备份 {state.get('last_file')}。"), repeat=24 * 3600, log=log)
    if not error:
        off = state.get("offsite", {})
        alert(conf, "backup:offsite", not off.get("ok"), "🟠 sbm 异地备份失败",
              f"本机备份成功，但复制到境外节点失败：{off.get('error')}", repeat=24 * 3600,
              recover=("🟢 sbm 异地备份恢复正常", f"已保存到 {off.get('node')}。"), log=log)
    if error:
        raise SbmError(error)
    return state


def backup_list():
    files = []
    if os.path.isdir(BACKUP_DIR):
        for f in sorted((f for f in os.listdir(BACKUP_DIR) if BACKUP_RE.match(f)), reverse=True):
            p = os.path.join(BACKUP_DIR, f)
            files.append({"name": f, "size": os.path.getsize(p), "mtime": int(os.path.getmtime(p))})
    return {"files": files, "state": load(BACKUP_STATE, {}), "keep": BACKUP_KEEP, "dir": BACKUP_DIR,
            "offsite_dir": OFFSITE_DIR}


# ---------- 健康检查与每周简报 ----------
# 每 5 分钟（sbm-health.timer）检查一遍，异常时通过 alert() 告警（自带去重、提醒间隔和恢复通知）。

CERT_WARN_DAYS = 15
LOGIN_FAIL_LIMIT = 10      # 同一 IP 15 分钟内登录失败次数
DISK_WARN_PCT = 85


def cert_days_file(path):
    r = subprocess.run(["openssl", "x509", "-enddate", "-noout", "-in", path], capture_output=True, text=True)
    m = re.search(r"notAfter=(.+)", r.stdout)
    return int((ssl.cert_time_to_seconds(m.group(1).strip()) - time.time()) // 86400) if m else None


def _login_failures(minutes=15):
    """统计最近一段时间控制台（/admin）登录失败（401）的来源 IP。"""
    counts = {}
    since = datetime.now().astimezone() - timedelta(minutes=minutes)
    try:
        with open("/var/log/nginx/access.log", "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 4 * 1024 * 1024))  # 只看最后 4MB
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return counts
    for line in lines:
        m = re.match(r'(\S+) \S+ \S+ \[([^\]]+)\] "\S+ (/admin\S*) [^"]*" 401 ', line)
        if not m:
            continue
        try:
            if datetime.strptime(m.group(2), "%d/%b/%Y:%H:%M:%S %z") >= since:
                counts[m.group(1)] = counts.get(m.group(1), 0) + 1
        except ValueError:
            pass
    return counts


def health_run(conf, log=print):
    """跑一遍健康检查并按需告警，返回 [(检查项, 是否正常, 说明)] 供显示。"""
    out = []

    def check(key, bad, item, msg, title, text, recover=None, need=1, repeat=6 * 3600):
        out.append((item, not bad, msg))
        alert(conf, key, bad, title, text, recover=recover, need=need, repeat=repeat, log=log)

    # 1. 证书：订阅域名读本机文件；节点读最近一次探测时节点实际出示的证书
    d = cert_days_file(f"/etc/letsencrypt/live/{conf['sub_domain']}/fullchain.pem")
    if d is not None:
        check("cert:sub", d < CERT_WARN_DAYS, f"证书 {conf['sub_domain']}", f"剩 {d} 天",
              f"🟠 sbm 证书即将到期：{conf['sub_domain']}", f"只剩 {d} 天，自动续期可能失败，请检查 certbot 与 Cloudflare Token。",
              recover=("🟢 sbm 证书已续期", f"{conf['sub_domain']} 证书已更新。"), repeat=24 * 3600)
    probe = probe_summary(conf)
    for name, r in probe["nodes"].items():
        if r.get("cert_days") is not None:
            check(f"cert:{name}", r["cert_days"] < CERT_WARN_DAYS, f"证书 {name}", f"剩 {r['cert_days']} 天",
                  f"🟠 sbm 节点证书即将到期：{name}",
                  f"节点 {name} 的证书只剩 {r['cert_days']} 天。sbm 部署的节点由订阅服务器续期；「接入」的节点请检查节点上的 certbot。",
                  recover=("🟢 sbm 节点证书已续期", f"{name} 证书已更新。"), repeat=24 * 3600)

    # 2. 节点上的内核服务与磁盘（连不上的节点由可达性探测负责告警）
    def node_check(node):
        return node, ssh(node, f"systemctl is-active {kernel_of(node)['service']}; df -P / | awk 'NR==2{{print $5}}'")
    with ThreadPoolExecutor(max_workers=8) as pool:
        for node, r in pool.map(node_check, conf["nodes"]):
            if r.returncode not in (0, 3):  # is-active 不在运行时返回 3
                out.append((f"节点 {node['name']}", None, "SSH 连不上（见国内可达性）"))
                continue
            lines = r.stdout.split()
            svc = lines[0] if lines else "unknown"
            pct = int(lines[1].rstrip("%")) if len(lines) > 1 and lines[1].rstrip("%").isdigit() else 0
            k = kernel_of(node)
            check(f"svc:{node['name']}", svc != "active", f"{k['label']} {node['name']}", svc,
                  f"🔴 sbm 节点 {k['label']} 未运行：{node['name']}", f"服务状态 {svc}。在节点上运行 journalctl -u {k['service']} -n 50 查看原因。",
                  recover=(f"🟢 sbm 节点 {k['label']} 已恢复", f"{node['name']} 的 {k['label']} 重新运行。"), need=2)
            check(f"disk:{node['name']}", pct >= 90, f"磁盘 {node['name']}", f"{pct}%",
                  f"🟠 sbm 节点磁盘快满：{node['name']}", f"已用 {pct}%，日志过多可能导致 {k['label']} 异常。",
                  repeat=24 * 3600)

    # 3. 账号推送失败的节点
    dirty = load_creds()["dirty"]
    check("dirty", bool(dirty), "账号同步", "、".join(dirty) + " 待同步" if dirty else "正常",
          "🟠 sbm 节点账号未同步", f"推送账号到 {'、'.join(dirty)} 失败，部分新用户可能连不上这些节点。可在控制台点「同步节点」重试。",
          recover=("🟢 sbm 节点账号已同步", "所有节点的账号已一致。"))

    # 4. 流量采集
    ts = traffic_summary(conf)
    if ts["enabled"] and ts["collected"]:
        age = (datetime.now() - datetime.strptime(ts["collected"], "%Y-%m-%d %H:%M")).total_seconds() / 60
        check("traffic:stale", age > 20, "流量采集", f"{int(age)} 分钟前",
              "🟠 sbm 流量采集停止", f"已经 {int(age)} 分钟没有采集，检查 systemctl status sbm-traffic.timer。",
              recover=("🟢 sbm 流量采集已恢复", "流量统计恢复正常。"))
        for name, st in ts["status"].items():
            check(f"traffic:{name}", not st["ok"], f"流量采集 {name}", st["error"] or "正常",
                  f"🟠 sbm 节点流量采集失败：{name}", st["error"], need=3,
                  recover=("🟢 sbm 节点流量采集已恢复", f"{name} 恢复正常。"))

    # 5. 控制台登录失败（疑似暴力破解）
    fails = _login_failures()
    for ip, n in fails.items():
        check(f"login:{ip}", n >= LOGIN_FAIL_LIMIT, f"登录失败 {ip}", f"15 分钟 {n} 次",
              "🔴 sbm 控制台疑似被暴力破解", f"{ip} 在 15 分钟内登录失败 {n} 次。若不是你本人，建议修改管理员密码，或在 Nginx 里限制来源 IP。")
    with alerts_locked():
        stale = [k for k in load(ALERTS, {}).get("active", {}) if k.startswith("login:") and k[6:] not in fails]
    for k in stale:
        alert(conf, k, False, "", "", log=log)
    if not fails:
        out.append(("控制台登录", True, "15 分钟内无失败"))

    # 6. 订阅服务器磁盘与备份
    du = shutil.disk_usage("/")
    pct = int(du.used * 100 / du.total)
    check("disk:mgmt", pct >= DISK_WARN_PCT, "磁盘 订阅服务器", f"{pct}%",
          "🟠 sbm 订阅服务器磁盘快满", f"已用 {pct}%，请清理（日志、旧备份）。", repeat=24 * 3600)
    bs = load(BACKUP_STATE, {})
    if bs.get("last_ok"):
        hours = (time.time() - bs["last_ok"]) / 3600
        check("backup:stale", hours > 36, "最近备份", f"{int(hours)} 小时前",
              "🟠 sbm 已超过 36 小时没有成功备份", f"上次成功备份在 {int(hours)} 小时前，检查 systemctl status sbm-backup.timer。",
              recover=("🟢 sbm 备份恢复正常", "已有新的备份。"), repeat=24 * 3600)
    return out


def report_text(conf, days=7):
    """每周简报：用户、流量、节点可用率、证书、备份、告警。"""
    now = datetime.now()
    start = now - timedelta(days=days)
    users = load_users()
    lines = [f"统计区间：{start:%m-%d} ~ {now:%m-%d}"]
    new = [u["name"] for u in users if u["created"] >= f"{start:%Y-%m-%d %H:%M}"]
    lines.append(f"用户：共 {len(users)} 个，启用 {sum(u['enabled'] for u in users)} 个"
                 + (f"，本周新增 {len(new)} 个（{'、'.join(new)}）" if new else ""))
    if os.path.exists(TRAFFIC_DB):
        con = traffic_db()
        rows = con.execute("SELECT uid, SUM(up + down) FROM usage WHERE day >= ? GROUP BY uid ORDER BY 2 DESC",
                           (f"{start:%Y-%m-%d}",)).fetchall()
        con.close()
        names = {u["id"]: u["name"] for u in users}
        total = sum(r[1] for r in rows)
        top = "、".join(f"{names.get(uid, '已删除用户')} {fmt_bytes(b)}" for uid, b in rows[:5])
        lines.append(f"流量：合计 {fmt_bytes(total)}" + (f"；最多：{top}" if top else ""))
    if os.path.exists(PROBE_DB):
        con = probe_db()
        lines.append("节点（国内可用率 / 平均代理延迟）：")
        for n in conf["nodes"]:
            total, good, avg = con.execute(
                "SELECT COUNT(*), SUM(status='ok'), AVG(CASE WHEN status='ok' THEN proxy_ms END) FROM probe WHERE node=? AND ts>=?",
                (n["name"], int(start.timestamp()))).fetchone()
            if total:
                lines.append(f"  · {n['name']}：{100 * (good or 0) / total:.1f}% / {int(avg) if avg else '—'} ms")
        con.close()
    certs = []
    d = cert_days_file(f"/etc/letsencrypt/live/{conf['sub_domain']}/fullchain.pem")
    if d is not None:
        certs.append((d, conf["sub_domain"]))
    certs += [(r["cert_days"], k) for k, r in probe_summary(conf)["nodes"].items() if r.get("cert_days") is not None]
    if certs:
        d, name = min(certs)
        lines.append(f"证书：最早到期的是 {name}，还剩 {d} 天")
    bs = load(BACKUP_STATE, {})
    if bs.get("last_ok"):
        off = bs.get("offsite", {})
        lines.append(f"备份：最近一次 {datetime.fromtimestamp(bs['last_ok']):%m-%d %H:%M}，"
                     + (f"异地副本在 {off.get('node')}" if off.get("ok") else "⚠ 异地副本失败"))
    creds = load_creds()
    lines.append(f"账号池：{len(creds['spares'])}/{pool_size(conf)}")
    hist = [h for h in load(ALERTS, {}).get("history", []) if h["ts"] >= start.timestamp()
            and not h["title"].startswith(("📊", "🔔"))]
    lines.append(f"本周告警：{len(hist)} 条" + (f"（最近一条：{hist[-1]['title']}）" if hist else ""))
    return "\n".join(lines)


# ---------- 命令 ----------

def cmd_user(args, conf):
    users, creds = load_users(), load_creds()
    if args.action == "list":
        profiles = load_profiles()
        print(f"{'用户':<20}{'状态':<14}{'节点账号':<16}{'创建时间':<20}配置")
        for u in users:
            status = "启用" if u["enabled"] else ("停用·待清理" if pending_purge(creds, u) else "停用")
            print(f"{u['name']:<20}{status:<14}{u['cred']:<16}{u['created']:<20}{user_profile(u, profiles)['name']}")
        print(f"\n账号池 {len(creds['spares'])}/{pool_size(conf)}，待清理 {len(creds['retiring'])} 个")
        return
    if args.action == "show":
        try:
            u = get_user(users, args.name)
        except SbmError as e:
            die(str(e))
        print(f"用户: {u['name']}  状态: {'启用' if u['enabled'] else '停用'}")
        for label, link in sub_links(conf, u).items():
            print(f"  {label}:\n    {link}")
        return
    if args.action == "config":
        try:
            u = get_user(users, args.name)
        except SbmError as e:
            die(str(e))
        if args.format != "overview":
            files = read_sub_files(u)
            if files is None:
                die(f"用户 {u['name']} 已停用，没有订阅文件")
            text = files[args.format]
            if args.format == "uri":  # 通用链接是 base64，解码后更好读
                text = base64.b64decode(text).decode() + "\n"
            sys.stdout.write(text)
            return
        ov = subscription_overview(conf, user_profile(u, load_profiles()))
        print(f"用户 {u['name']} 的订阅配置（{'启用' if u['enabled'] else '停用，当前没有下发'}），"
              f"使用「{ov['profile']['name']}」\n")
        print_overview(ov)
        print("\n查看原始内容: sbm user config <名字> --format singbox|clash|uri")
        return
    try:
        if args.action == "add":
            pid = find_profile(args.profile)["id"] if args.profile else None
            need_push, notice = user_add(users, creds, args.name, args.note or "", args.password, pid)
        elif args.action == "del":
            need_push, notice = user_delete(users, creds, args.name, args.now)
        elif args.action == "disable":
            need_push, notice = user_disable(users, creds, args.name, args.now)
        elif args.action == "enable":
            need_push, notice = user_enable(users, creds, args.name)
        else:  # reset
            need_push, notice = user_reset(users, creds, args.name, not args.later)
        ok = commit(conf, users, creds, need_push)
    except SbmError as e:
        die(str(e))
    if notice:
        print(notice)
    if args.action in ("add", "reset", "enable") and ok:
        u = get_user(users, args.name)
        for label, link in sub_links(conf, u).items():
            print(f"  {label}:\n    {link}")
    sys.exit(0 if ok else 1)


def find_profile(key):
    """命令行按名称或 id 查找配置。"""
    for p in all_profiles():
        if key in (p["id"], p["name"]):
            return p
    raise SbmError(f"配置 {key} 不存在，sbm profile list 可以查看全部配置")


def profile_text(p):
    if p["mode"] == "global":
        return "全局代理"
    return f"规则分流，{sum(1 for s in p['services'].values() if s['enabled'])} 个服务组"


def print_overview(ov):
    print("节点:")
    for n in ov["nodes"]:
        print(f"  {n['name']:<18}{n['protocol']}  {n['server']}:{n['port']}  {n['region']}")
    print("\n代理组（默认 → 可选）:")
    for g in ov["groups"]:
        print(f"  {g['name']}  [{g['type']}]  默认 {g['default']}")
        print(f"      {' / '.join(g['members'])}")
    print("\n分流规则（从上到下依次匹配）:")
    for i, r in enumerate(ov["rules"], 1):
        print(f"  {i:>2}. {r['match']}  →  {r['target']}")
    print("\nDNS:\n  " + "\n  ".join(ov["dns"]))
    print(f"\n规则数据: {ov['rule_source']}")


def cmd_profile(args, conf):
    users = load_users()
    try:
        if args.action == "list":
            profiles = all_profiles()
            print(f"{'配置':<24}{'用户数':<8}内容")
            for p in profiles:
                count = sum(1 for u in users if user_profile(u, profiles)["id"] == p["id"])
                nodes = "全部节点" if not p["nodes"] else f"{len(profile_nodes(conf, p))} 个节点"
                extra = f"，{len(p['custom_rules'])} 条自定义规则" if p["custom_rules"] else ""
                extra += f"，{len(p['app_rules'])} 条应用规则" if p.get("app_rules") else ""
                print(f"{p['name']:<24}{count:<8}{nodes}，{profile_text(p)}{extra}")
            print("\n新建和修改配置请用控制台的「配置管理」；sbm user list 可以查看每个用户用的配置")
        elif args.action == "show":
            if not args.name:
                die("需要指定配置名称")
            p = find_profile(args.name)
            print(f"配置 {p['name']}：{profile_text(p)}\n")
            print_overview(subscription_overview(conf, p))
        else:  # apply
            if not args.name or not args.users:
                die("用法: sbm profile apply <配置> <用户> [<用户> ...]")
            p = find_profile(args.name)
            profiles = load_profiles()
            for name in args.users:
                set_user_profile(get_user(users, name), profiles, p["id"])
            commit(conf, users, load_creds(), False)
            print(f"{len(args.users)} 个用户已切换到「{p['name']}」，在客户端更新订阅后生效")
    except SbmError as e:
        die(str(e))


def cmd_domain(args, conf):
    try:
        if args.action == "list":
            default = base_domain(conf)
            print(f"{'域名':<26}{'默认':<6}{'用途':<36}备注")
            for d in domains(conf):
                used = "、".join(domain_usage(conf, d["zone"])) or "未使用"
                print(f"{d['zone']:<26}{'✓' if d['zone'] == default else '':<6}{used:<36}{d.get('note', '')}")
            return
        if not args.zone:
            die("需要指定域名")
        if args.action == "check":
            for line in domain_check(conf, args.zone):
                print("✓ " + line)
        elif args.action in ("add", "token"):
            # Token 从隐藏输入读取，不出现在命令行参数和 shell 历史里
            import getpass
            token = getpass.getpass("Cloudflare API Token（输入时不显示）: ")
            lines = (domain_add(conf, args.zone, token, args.note or "") if args.action == "add"
                     else domain_set_token(conf, args.zone, token))
            for line in lines:
                print("✓ " + line)
            print(f"已保存 {args.zone} 的 Token")
        elif args.action == "default":
            domain_set_default(conf, args.zone)
            print(f"默认域名已改为 {args.zone}")
        elif args.action == "del":
            domain_del(conf, args.zone)
            print(f"已删除 {args.zone}")
    except SbmError as e:
        die(str(e))


def cmd_traffic(args, conf):
    if args.action == "collect":
        with locked():
            raw = load(USERS, [])
            users = load_users()
            if any("id" not in u for u in raw):
                save_users(users)  # 老用户第一次补上固定 id
            collect(conf, users, load_creds(), log=print if args.verbose else (lambda *_: None))
            if write_userinfo_map(conf, users):
                subprocess.run(["systemctl", "reload", "nginx"], check=False)
        return
    summary = traffic_summary(conf)
    if not summary["enabled"]:
        die("还没有流量数据，请先运行 sbm sync 启用统计")
    month = datetime.now().strftime("%Y-%m")
    print(f"{month} 本月流量（更新于 {summary['collected']}）\n")
    print(f"{'用户':<20}{'上传':>12}{'下载':>12}{'合计':>12}")
    for u in load_users():
        up, down = summary["users"].get(u["id"], [0, 0])
        print(f"{u['name']:<20}{fmt_bytes(up):>12}{fmt_bytes(down):>12}{fmt_bytes(up + down):>12}")
    up, down = summary["month_total"]
    print(f"{'合计':<20}{fmt_bytes(up):>12}{fmt_bytes(down):>12}{fmt_bytes(up + down):>12}")
    bad = {n: s["error"] for n, s in summary["status"].items() if not s["ok"]}
    if bad:
        print("\n采集失败的节点: " + "; ".join(f"{n}（{e}）" for n, e in bad.items()))


def cmd_probe(args, conf):
    if args.action == "run":
        probe_run(conf, log=print if args.verbose else (lambda *_: None))
        if not args.verbose:
            return
        print()
    s = probe_summary(conf)
    if not s["enabled"] or not s["nodes"]:
        die("还没有探测数据，运行 sbm probe run 立即检测一次")
    print(f"国内可达性（上次检测 {datetime.fromtimestamp(s['last_run']):%m-%d %H:%M}）\n")
    for name, r in s["nodes"].items():
        up = f"{r['uptime_24h']}%" if r["uptime_24h"] is not None else "—"
        print(f"  {name:<16}{r['label']:<24}代理 {r['proxy_ms'] or '—'} ms  TCP {r['tcp_ms'] or '—'} ms  24 小时可用率 {up}")
        for d in r["detail"]:
            print(f"      · {d}")


def cmd_backup(args, conf):
    if args.action == "run":
        try:
            backup_run(conf)
        except SbmError as e:
            die(str(e))
        return
    if args.action == "key":
        print("备份解密密钥（请保存到密码管理器等安全的地方；订阅服务器丢失时，用它解密境外节点上的异地副本）：\n")
        print(backup_key())
        return
    info = backup_list()
    st = info["state"]
    off = st.get("offsite", {})
    print(f"本机备份（{info['dir']}，保留 {info['keep']} 份）：")
    for f in info["files"]:
        print(f"  {f['name']}  {fmt_bytes(f['size'])}")
    if not info["files"]:
        print("  （还没有）")
    if off:
        print(f"\n异地副本：{'成功，' + off['node'] + ':' + info['offsite_dir'] + '/' + off['file'] if off.get('ok') else '失败 ' + off.get('error', '')}")
    if st.get("last_error"):
        print(f"最近一次失败：{datetime.fromtimestamp(st['last_fail']):%m-%d %H:%M} {st['last_error']}")


def cmd_health(args, conf):
    for item, ok, msg in health_run(conf, log=lambda *_: None):
        mark = "—" if ok is None else ("✓" if ok else "✗")
        print(f"  {mark} {item:<28}{msg}")


def cmd_report(args, conf):
    text = report_text(conf)
    print(text)
    if args.action == "send":
        results = notify_all(conf, "📊 sbm 每周简报", text)
        print("\n" + ("；".join(f"{n}: {'已发送' if not e else '失败 ' + e}" for n, e in results) or "没有启用的通知渠道"))


def cmd_notify(args, conf):
    data = load_notify()
    if args.action == "send":  # 供 systemd OnFailure 等脚本调用
        notify_all(conf, args.title or "sbm 通知", args.text or "")
        return
    if args.action == "list":
        if not data["channels"]:
            print("还没有通知渠道，请在控制台「通知」里添加")
        for ch in data["channels"]:
            m = mask_channel(ch)
            print(f"  [{m['id']}] {m['type_name']:<8}{m['name']:<16}{'启用' if m['enabled'] else '停用'}  {m['target']}")
        return
    results = notify_all(conf, "🔔 sbm 测试通知", f"这是一条测试消息，发送时间 {datetime.now():%Y-%m-%d %H:%M}。")
    if not results:
        die("没有启用的通知渠道")
    for name, err in results:
        print(f"  {name}: {'成功' if not err else '失败 ' + err}")


def cmd_pool(conf):
    creds = load_creds()
    print(f"备用账号: {len(creds['spares'])}/{pool_size(conf)}")
    print(f"待清理账号: {len(creds['retiring'])}")
    for r in creds["retiring"]:
        print(f"  {r['user']:<20}{r['reason']:<6}{r['since']}")
    if creds["dirty"]:
        print(f"未同步成功的节点: {', '.join(creds['dirty'])}")
    r = subprocess.run(["systemctl", "list-timers", "sbm-maintain.timer", "--no-pager"],
                       capture_output=True, text=True)
    nxt = r.stdout.splitlines()[1:2]
    print(f"下次维护: {nxt[0].split('  ')[0] if nxt else '未设置定时任务'}")


def cmd_status(conf):
    for node in conf["nodes"]:
        k = kernel_of(node)
        r = ssh(node, f"systemctl is-active {k['service']}; {k['version']}")
        print(f"[{node['name']}] {node['host']}: {k['label']} {' / '.join(r.stdout.split(chr(10))[:2]) or r.stderr.strip()}")


def cmd_node(args, conf):
    users = load_users()
    if args.action == "list":
        print(f"{'节点':<18}{'类型':<8}{'内核':<10}{'服务器':<18}地址")
        for n in conf["nodes"]:
            kind = "部署" if n.get("managed") else "接入"
            inner = f"（内部 {n['listen_port']}）" if "listen_port" in n else ""
            print(f"{n['name']:<18}{kind:<8}{kernel_of(n)['label']:<10}{n['host']:<18}{n['server']}:{n['port']}{inner}")
        return
    if args.action == "pubkey":
        print("在新服务器上以 root 运行下面这条命令，授权订阅服务器管理它：\n")
        print(authorize_command(conf))
        return
    if args.action == "versions":
        for kernel in sorted({n.get("kernel", DEFAULT_KERNEL) for n in conf["nodes"]}):
            try:
                rel = releases(refresh=True, kernel=kernel)
            except SbmError as e:
                die(str(e))
            print(f"{KERNELS[kernel]['label']} 最新正式版: {rel['latest']}{'（GitHub 连不上，用的是缓存）' if rel.get('stale') else ''}")
            print(f"近期正式版: {', '.join(rel['stable'])}\n")
            for n in conf["nodes"]:
                if n.get("kernel", DEFAULT_KERNEL) == kernel:
                    v = node_version(n) or "无法连接"
                    print(f"  {n['name']:<18}{v:<12}{'✓ 最新' if v == rel['latest'] else '可升级'}")
            print()
        return
    if args.action == "upgrade":
        names = [n["name"] for n in conf["nodes"]] if args.all else ([args.name] if args.name else [])
        if not names:
            die("指定节点名，或用 --all 升级全部节点")
        try:
            upgrade_nodes(conf, names, args.version)
        except SbmError as e:
            die(str(e))
        return
    if not args.name:
        die("需要指定节点名")
    try:
        if args.action == "deploy":
            if not (args.host and args.sub):
                die("deploy 需要 --host 和 --sub")
            deploy_node(conf, users, args.name, args.host, args.ssh_port, args.sub, args.port, args.zone,
                        kernel=args.kernel, listen=args.listen_port)
        elif args.action == "attach":
            if not args.host:
                die("attach 需要 --host")
            attach_node(conf, users, args.name, args.host, args.ssh_port, args.inbound_tag,
                        args.config_path, args.server)
        elif args.action == "del":
            remove_node(conf, users, args.name)
    except SbmError as e:
        die(str(e))


def main():
    if os.geteuid() != 0:
        die("请用 sudo 运行")
    p = argparse.ArgumentParser(prog="sbm", description="sing-box 用户与订阅管理")
    sub = p.add_subparsers(dest="cmd", required=True)
    pu = sub.add_parser("user", help="用户管理", description=(
        "add / enable：使用账号池，立即生效，节点不重启\n"
        "del / disable：订阅立即失效，节点账号在每天维护时清理；加 --now 立即踢下线（重启节点）\n"
        "reset：默认立即让旧密码失效（重启节点）；加 --later 改为维护时失效\n"
        "config：查看订阅配置概览（节点、代理组、分流规则）；--format singbox|clash|uri 查看实际下发的原文"),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    pu.add_argument("action", choices=["list", "add", "del", "enable", "disable", "reset", "show", "config"])
    pu.add_argument("--format", choices=["overview", "singbox", "clash", "uri"], default="overview",
                    help="config: 查看概览，或实际下发的 sing-box / Clash / 通用链接内容")
    pu.add_argument("name", nargs="?")
    pu.add_argument("--password", help="add: 指定密码（不走账号池，需要重启节点）")
    pu.add_argument("--note", help="add: 备注")
    pu.add_argument("--profile", help="add: 使用的配置（名称或 id，默认用默认配置）")
    pu.add_argument("--now", action="store_true", help="del/disable: 立即踢下线（重启节点）")
    pu.add_argument("--later", action="store_true", help="reset: 旧密码在下次维护时才失效（不重启）")
    pfl = sub.add_parser("profile", help="订阅配置：list 查看；show <配置> 查看内容；apply <配置> <用户...> 应用到用户（不重启节点）")
    pfl.add_argument("action", choices=["list", "show", "apply"])
    pfl.add_argument("name", nargs="?")
    pfl.add_argument("users", nargs="*")
    pn = sub.add_parser("node", help="节点管理", description=(
        "deploy: 在全新服务器上一键部署（自动 DNS、证书、安装内核；--kernel prism 用自研内核）\n"
        "attach: 接入已装好 sing-box 且有 AnyTLS 入站的服务器\n"
        "versions: 查看各节点内核版本和最新版本\n"
        "upgrade: 升级内核，例如 sbm node upgrade --all 或 sbm node upgrade HK-01 --version 1.14.3\n"
        "先运行 sbm node pubkey，把输出的命令在新服务器上以 root 执行一次"),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    pn.add_argument("action", choices=["list", "pubkey", "deploy", "attach", "del", "versions", "upgrade"])
    pn.add_argument("--all", action="store_true", help="upgrade: 升级全部节点")
    pn.add_argument("--version", help="upgrade: 目标版本（默认最新正式版）")
    pn.add_argument("name", nargs="?")
    pn.add_argument("--host", help="服务器 IP")
    pn.add_argument("--ssh-port", type=int, default=22)
    pn.add_argument("--sub", help="deploy: 子域名前缀，例如 hk1 → hk1.<主域名>")
    pn.add_argument("--zone", help="deploy: 使用域名管理里的哪个主域名（默认用默认域名）")
    pn.add_argument("--port", type=int, default=443, help="deploy: 客户端连接的 AnyTLS 端口（默认 443）")
    pn.add_argument("--listen-port", type=int, help="deploy: 服务器内部监听的端口（NAT 机器公网端口映射到内部端口时才需要）")
    pn.add_argument("--kernel", choices=sorted(KERNELS), default=DEFAULT_KERNEL, help="deploy: 节点内核（默认 sing-box）")
    pn.add_argument("--inbound-tag", default="anytls-in", help="attach: 入站 tag")
    pn.add_argument("--config-path", default="/etc/sing-box/config.json", help="attach: 配置文件路径")
    pn.add_argument("--server", help="attach: 节点域名（默认读取入站的 server_name）")
    pd = sub.add_parser("domain", help="节点域名与 Cloudflare Token 管理", description=(
        "list: 列出域名、默认域名和用途\n"
        "add <域名>: 添加域名，随后提示输入 Cloudflare Token（会验证 DNS 编辑权限）\n"
        "token <域名>: 更换 Token；check <域名>: 检测 Token 是否可用\n"
        "default <域名>: 设为部署节点时的默认域名；del <域名>: 删除未使用的域名"),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    pd.add_argument("action", choices=["list", "add", "token", "check", "default", "del"])
    pd.add_argument("zone", nargs="?")
    pd.add_argument("--note", help="add: 备注")
    sub.add_parser("sync", help="维护：清理旧账号、补满账号池并推送到所有节点（只有变化的节点会重启）")
    sub.add_parser("pool", help="查看账号池和待清理账号")
    pp = sub.add_parser("probe", help="国内可达性：sbm probe 查看；sbm probe run 立即检测（定时器每 5 分钟运行）")
    pp.add_argument("action", nargs="?", choices=["show", "run"], default="show")
    pp.add_argument("-v", "--verbose", action="store_true", help="run: 显示每个节点的检测过程")
    pf = sub.add_parser("notify", help="告警通知：sbm notify list 查看渠道；sbm notify test 发送测试消息")
    pf.add_argument("action", choices=["list", "test", "send"])
    pf.add_argument("--title", help="send: 标题")
    pf.add_argument("--text", help="send: 正文")
    pb = sub.add_parser("backup", help="备份：sbm backup 查看；sbm backup run 立即备份；sbm backup key 显示异地副本的解密密钥")
    pb.add_argument("action", nargs="?", choices=["list", "run", "key"], default="list")
    ph = sub.add_parser("health", help="健康检查：证书、节点服务与磁盘、账号同步、流量采集、登录失败、备份（定时器每 5 分钟运行）")
    ph.add_argument("action", nargs="?", choices=["run"], default="run")
    pr = sub.add_parser("report", help="每周简报：sbm report 预览；sbm report send 发送到通知渠道")
    pr.add_argument("action", nargs="?", choices=["show", "send"], default="show")
    pt = sub.add_parser("traffic", help="流量统计：sbm traffic 查看本月；sbm traffic collect 采集一次（定时器使用）")
    pt.add_argument("action", nargs="?", choices=["show", "collect"], default="show")
    pt.add_argument("-v", "--verbose", action="store_true", help="collect: 显示每个节点的采集结果")
    sub.add_parser("build", help="只重新生成订阅，不改节点")
    sub.add_parser("status", help="查看节点状态")
    pc = sub.add_parser("cert-renewed", help="certbot 续期钩子使用")
    pc.add_argument("domains", nargs="*")
    args = p.parse_args()

    conf = load(CONF)
    if args.cmd == "node":
        if args.action in ("list", "pubkey", "versions"):
            cmd_node(args, conf)
        else:
            with locked():
                cmd_node(args, load(CONF))
    elif args.cmd == "domain":
        if args.action in ("list", "check"):
            cmd_domain(args, conf)
        else:
            with locked():
                cmd_domain(args, load(CONF))
    elif args.cmd == "cert-renewed":
        renewed = args.domains or os.environ.get("RENEWED_DOMAINS", "").split()
        with locked():
            try:
                cert_renewed(load(CONF), renewed)
            except SbmError as e:
                die(str(e))
    elif args.cmd == "user":
        if args.action != "list" and not args.name:
            die("需要指定用户名")
        with locked():
            cmd_user(args, conf)
    elif args.cmd == "profile":
        with locked():
            cmd_profile(args, load(CONF))
    elif args.cmd == "sync":
        with locked():
            users = load_users()
            save_users(users)
            try:
                sys.exit(0 if reconcile(load(CONF), users, load_creds()) else 1)
            except SbmError as e:
                die(str(e))
    elif args.cmd == "pool":
        cmd_pool(conf)
    elif args.cmd == "probe":
        cmd_probe(args, conf)
    elif args.cmd == "notify":
        cmd_notify(args, conf)
    elif args.cmd == "backup":
        cmd_backup(args, conf)
    elif args.cmd == "health":
        cmd_health(args, conf)
    elif args.cmd == "report":
        cmd_report(args, conf)
    elif args.cmd == "traffic":
        cmd_traffic(args, conf)
    elif args.cmd == "build":
        build_subs(conf, load_users())
        print("订阅已生成")
    elif args.cmd == "status":
        cmd_status(conf)


if __name__ == "__main__":
    main()
