#!/usr/bin/env python3
"""sbm - sing-box 节点用户与订阅管理

数据:   /etc/sbm/config.json  订阅域名、节点列表
        /etc/sbm/users.json   用户（名称、节点账号、密码、订阅令牌、启用状态）
        /etc/sbm/creds.json   账号池（备用账号、待清理账号、未同步成功的节点）
        /etc/sbm/profiles.json 订阅配置（默认配置内置在程序里，这里只存新增的）
输出:   /var/www/sub/<token>/{singbox.json,clash.yaml,uri.txt}，由 Nginx 提供

为什么有账号池：sing-box 只在启动时读取用户列表，改用户必须重启节点。
节点上始终放着「启用用户 + 备用账号 + 待清理账号」这一整套账号，
新增用户只是把一个备用账号分配给他，节点上的账号集合不变，无需重启；
删除、停用的账号先留在节点上，由每天凌晨的维护（sbm sync）统一清理并补满账号池。
"""
import argparse
import base64
import contextlib
import fcntl
import glob
import hashlib
import hmac
import io
import ipaddress
import json
import os
import re
import secrets
import shlex
import shutil
import socket
import sqlite3
import ssl
import string
import struct
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta

ETC = "/etc/sbm"
CONF = f"{ETC}/config.json"
USERS = f"{ETC}/users.json"
WWW = "/var/www/sub"
ALNUM = string.ascii_letters + string.digits
NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,32}$")


def die(msg):
    print(f"错误: {msg}", file=sys.stderr)
    sys.exit(1)


def rand(n):
    return "".join(secrets.choice(ALNUM) for _ in range(n))


def load(path, default=None):
    if not os.path.exists(path):
        if default is None:
            die(f"找不到 {path}")
        return default
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def write_file(path, text, mode=0o644):
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


@contextlib.contextmanager
def locked():
    """命令行和 Web 管理界面共用的互斥锁，避免两边同时改用户、同时推送节点。"""
    with open(f"{ETC}/.lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def save_users(users):
    write_file(USERS, json.dumps(users, indent=2, ensure_ascii=False) + "\n", 0o600)


def load_users():
    users = load(USERS, [])
    for u in users:
        # 账号池之前创建的用户：节点上的账号名就是用户名
        u.setdefault("cred", u["name"])
        u.setdefault("note", "")
        # 流量统计按 id 归属，用户名可能被删除后重新使用；老用户在下一次保存时补上 id
        u.setdefault("id", secrets.token_hex(6))
    return users


# ---------- 节点内核 ----------
# 节点可以运行官方 sing-box，也可以运行自研的 Prism（prism-node-server，配置格式兼容 sing-box）。
# 对客户端都是 AnyTLS，订阅内容与内核无关。旧节点没有 kernel 字段，都是 sing-box。

DEFAULT_KERNEL = "sing-box"
KERNELS = {
    "sing-box": {
        "label": "sing-box", "repo": "SagerNet/sing-box", "service": "sing-box",
        "comm": "sing-box", "dir": "/etc/sing-box",
        "version": "sing-box version 2>/dev/null | awk 'NR==1{print $3}'",
    },
    "prism": {
        "label": "Prism", "repo": "yuuolo/prism-node-server", "service": "prism-node-server",
        # ss 显示的进程名最长 15 个字符
        "comm": "prism-node-serv", "dir": "/etc/prism-node-server",
        "version": "prism-node-server version 2>/dev/null | awk '{print $2}'",
    },
}


def kernel_of(node):
    return KERNELS[node.get("kernel", DEFAULT_KERNEL)]


def is_prism(node):
    return node.get("kernel") == "prism"


# ---------- 节点 ----------

def ssh_args(node, cmd):
    return [
        "ssh", "-i", node["ssh_key"], "-p", str(node.get("ssh_port", 22)),
        "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
        # 新节点第一次连接时自动记下主机密钥；之后密钥变了仍会拒绝连接
        "-o", "StrictHostKeyChecking=accept-new",
        f"{node['ssh_user']}@{node['host']}", cmd,
    ]


def ssh(node, cmd, stdin=""):
    # stdin 默认给空串：否则 ssh 会吞掉调用方（例如管道脚本）的标准输入
    return subprocess.run(ssh_args(node, cmd), input=stdin, capture_output=True, text=True)


def ssh_push(node, cmd, data):
    """和 ssh 一样，但标准输入是二进制内容（安装包）。"""
    r = subprocess.run(ssh_args(node, cmd), input=data, capture_output=True)
    return subprocess.CompletedProcess(r.args, r.returncode, r.stdout.decode(errors="replace"), r.stderr.decode(errors="replace"))


PUSH_SCRIPT = r"""
set -e
p={path}
ts=$(date +%Y%m%d-%H%M%S)
trap 'rm -f "$p.new"' EXIT
cat > "$p.new"
sing-box check -c "$p.new"
if cmp -s "$p" "$p.new"; then echo UNCHANGED; exit 0; fi
cp -a "$p" "$p.sbm-$ts"
mv "$p.new" "$p"
systemctl restart sing-box
sleep 2
if ! systemctl is-active --quiet sing-box; then
    cp -a "$p.sbm-$ts" "$p"
    systemctl restart sing-box
    echo ROLLBACK
    exit 1
fi
ls -1t "$p".sbm-* | tail -n +6 | xargs -r rm -f
echo APPLIED
"""

# Prism 热加载：用户和证书即时生效，已有连接不断，被删除或改了密码的账号立刻断开
PRISM_PUSH_SCRIPT = r"""
set -e
p={path}
ts=$(date +%Y%m%d-%H%M%S)
trap 'rm -f "$p.new"' EXIT
umask 077
cat > "$p.new"
chown --reference="$p" "$p.new"
prism-node-server check -c "$p.new" >/dev/null
if cmp -s "$p" "$p.new"; then echo UNCHANGED; exit 0; fi
cp -a "$p" "$p.sbm-$ts"
mv "$p.new" "$p"
if ! prism-node-server reload -c "$p" >/dev/null; then
    cp -a "$p.sbm-$ts" "$p"
    prism-node-server reload -c "$p" >/dev/null || true
    echo ROLLBACK
    exit 1
fi
ls -1t "$p".sbm-* | tail -n +6 | xargs -r rm -f
echo APPLIED
"""


# ---------- 流量统计（节点侧） ----------
# 官方 sing-box 没有按用户的流量计数器，做法是：每个账号一个专属 direct 出站，
# 用 routing_mark 给它的连接打上唯一编号，路由规则按 auth_user 把账号的流量送到对应出站；
# 节点上用 iptables 按编号计数（上传在 OUTPUT 计包标记，下载靠 CONNMARK 在 INPUT 计连接标记）。

STATS_PREFIX = "sbm-u-"
MARK_BASE = 0x5B0000  # 编号范围 0x5b0000~0x5bffff，用掩码 0xffff0000 识别

NODE_STATS_SCRIPT = r"""#!/bin/bash
# sbm 流量统计：按 sing-box 出站的 routing_mark 计数。由订阅服务器的 sbm 维护，请勿手动修改。
#   sbm-stats apply  按 /etc/sbm-stats.marks 增删计数规则（只增删差异，已有计数不清零）
#   sbm-stats read   输出 "族 方向 编号 字节数"
MARKS=/etc/sbm-stats.marks
apply() {
  for t in iptables ip6tables; do
    command -v $t >/dev/null || continue
    $t -t mangle -N SBM_OUT 2>/dev/null; $t -t mangle -N SBM_IN 2>/dev/null
    $t -t mangle -C OUTPUT -j SBM_OUT 2>/dev/null || $t -t mangle -I OUTPUT -j SBM_OUT
    $t -t mangle -C INPUT -j SBM_IN 2>/dev/null || $t -t mangle -I INPUT -j SBM_IN
    $t -t mangle -C SBM_OUT -m mark --mark 0x5b0000/0xffff0000 -j CONNMARK --save-mark 2>/dev/null \
      || $t -t mangle -I SBM_OUT -m mark --mark 0x5b0000/0xffff0000 -j CONNMARK --save-mark
    want=$(cat $MARKS 2>/dev/null)
    have=$($t -t mangle -S SBM_IN | sed -n 's/.*--mark \(0x[0-9a-f]*\) -j RETURN.*/\1/p')
    for m in $want; do
      grep -qx "$m" <<<"$have" || { $t -t mangle -A SBM_OUT -m mark --mark $m -j RETURN; $t -t mangle -A SBM_IN -m connmark --mark $m -j RETURN; }
    done
    for m in $have; do
      grep -qx "$m" <<<"$want" || { $t -t mangle -D SBM_OUT -m mark --mark $m -j RETURN; $t -t mangle -D SBM_IN -m connmark --mark $m -j RETURN; }
    done
  done
}
read_counters() {
  for t in iptables ip6tables; do
    command -v $t >/dev/null || continue
    f=$([ $t = iptables ] && echo v4 || echo v6)
    $t -t mangle -L SBM_OUT -nvx 2>/dev/null | awk -v f=$f '$3=="RETURN"{print f, "up", $NF, $2}'
    $t -t mangle -L SBM_IN -nvx 2>/dev/null | awk -v f=$f '$3=="RETURN"{print f, "down", $NF, $2}'
  done
}
case "$1" in
  apply) apply ;;
  read) read_counters ;;
  *) echo "用法: sbm-stats apply|read" >&2; exit 2 ;;
esac
"""


def apply_stats_routing(cfg, cred_list, marks):
    """在节点配置里为每个账号生成专属出站和路由规则（先删掉 sbm 以前生成的，再追加）。
    追加在原有规则之后，节点上原有的分流规则仍然优先。"""
    outs = [o for o in cfg.get("outbounds", []) if not str(o.get("tag", "")).startswith(STATS_PREFIX)]
    if not outs:
        outs = [{"type": "direct", "tag": "direct"}]  # 第一个出站是默认出站，不能是统计用的
    route = cfg.setdefault("route", {})
    rules = [r for r in route.get("rules", []) if not str(r.get("outbound", "")).startswith(STATS_PREFIX)]
    for c in cred_list:
        tag = STATS_PREFIX + c["name"]
        outs.append({"type": "direct", "tag": tag, "routing_mark": marks[c["name"]]})
        rules.append({"auth_user": [c["name"]], "outbound": tag})
    cfg["outbounds"] = outs
    route["rules"] = rules


def install_stats(node, cred_list, marks):
    """安装/更新节点上的计数脚本和编号列表，并立即应用规则。"""
    mark_lines = "".join(f"{marks[c['name']]:#x}\n" for c in cred_list)
    cmd = ("cat > /usr/local/sbin/sbm-stats.new && chmod 755 /usr/local/sbin/sbm-stats.new"
           " && mv /usr/local/sbin/sbm-stats.new /usr/local/sbin/sbm-stats"
           f" && printf %s {shlex.quote(mark_lines)} > /etc/sbm-stats.marks && /usr/local/sbin/sbm-stats apply")
    r = ssh(node, cmd, stdin=NODE_STATS_SCRIPT)
    if r.returncode != 0:
        raise SbmError(f"安装流量统计规则失败: {(r.stdout + r.stderr).strip()[-500:]}")


def push_node(node, cred_list, marks):
    """把账号写进节点入站的 users，并生成按账号统计流量的出站与规则。
    内容没变就不动；变了才校验、重启，启动失败自动回滚。
    Prism 内置按用户统计，不需要统计出站和 iptables 规则；账号变化时热加载，不重启。"""
    r = ssh(node, f"cat {shlex.quote(node['config_path'])}")
    if r.returncode != 0:
        return False, f"读取配置失败: {r.stderr.strip()}"
    cfg = json.loads(r.stdout)
    inbound = next((i for i in cfg.get("inbounds", []) if i.get("tag") == node["inbound_tag"]), None)
    if inbound is None:
        return False, f"配置中没有 tag 为 {node['inbound_tag']} 的入站"
    inbound["users"] = cred_list
    if is_prism(node):
        script = PRISM_PUSH_SCRIPT
    else:
        script = PUSH_SCRIPT
        apply_stats_routing(cfg, cred_list, marks)
        try:
            install_stats(node, cred_list, marks)
        except SbmError as e:
            return False, str(e)
    new = json.dumps(cfg, indent=2, ensure_ascii=False) + "\n"
    r = ssh(node, script.format(path=shlex.quote(node["config_path"])), stdin=new)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0:
        return False, out
    return True, out.splitlines()[-1]


# ---------- 节点增删与部署 ----------

KEY = "/root/.ssh/sbm_node"
CF_INI = "/etc/letsencrypt/cloudflare.ini"
NODE_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,32}$")
SUB_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$")
HOST_RE = re.compile(r"^[A-Za-z0-9.-]{1,253}$")


class SbmError(Exception):
    pass


def save_conf(conf):
    write_file(CONF, json.dumps(conf, indent=2, ensure_ascii=False) + "\n", 0o600)


def base_domain(conf):
    return conf.get("base_domain") or conf["sub_domain"].split(".", 1)[1]


def authorize_command(conf):
    """新节点上运行一次的授权命令：只允许来自订阅服务器 IP 的这把密钥登录 root。"""
    with open(f"{KEY}.pub", encoding="utf-8") as f:
        pub = f.read().strip()
    line = f'from="{conf["manager_ip"]}" {pub}'
    return (
        "mkdir -p /root/.ssh && chmod 700 /root/.ssh && "
        f"grep -qF '{pub.split()[1]}' /root/.ssh/authorized_keys 2>/dev/null || "
        f"echo '{line}' >> /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys"
    )


def check_node_args(conf, name, host, ssh_port):
    if not NODE_NAME_RE.match(name or ""):
        raise SbmError("节点名只能包含字母、数字、_ . -，最长 32 位")
    if any(n["name"] == name for n in conf["nodes"]):
        raise SbmError(f"节点 {name} 已存在")
    if not HOST_RE.match(host or ""):
        raise SbmError("服务器地址无效")
    if any(n["host"] == host for n in conf["nodes"]):
        raise SbmError(f"服务器 {host} 已经在节点列表里")
    if not 1 <= int(ssh_port) <= 65535:
        raise SbmError("SSH 端口无效")


def ssh_ok(node, cmd, what):
    r = ssh(node, cmd)
    if r.returncode != 0:
        raise SbmError(f"{what}失败:\n{(r.stdout + r.stderr).strip()[-1500:]}")
    return r.stdout.strip()


def check_root_ssh(node, log):
    log(f"连接 root@{node['host']}:{node['ssh_port']} …")
    r = ssh(node, '. /etc/os-release 2>/dev/null; echo "$(id -u)|$PRETTY_NAME|$(uname -m)"')
    if r.returncode != 0:
        raise SbmError(
            "SSH 登录失败。请确认已在新服务器上以 root 运行过授权命令，且安全组放行了 SSH 端口。\n"
            + r.stderr.strip()[-500:]
        )
    uid, osname, arch = (r.stdout.strip().split("|") + ["", ""])[:3]
    if uid != "0":
        raise SbmError("需要 root 权限，请把授权命令加到 root 用户上")
    log(f"  已连接：{osname} ({arch})")


# ---------- 域名与 Cloudflare Token ----------
# 每个主域名（Cloudflare 里的一个 zone）一个 Token 文件，certbot 格式，仅 root 可读。
# 安装时设置的主域名沿用 /etc/letsencrypt/cloudflare.ini，已签发证书的续期配置都指向它；
# 之后添加的域名放在 CF_DIR 下。Token 写入后不会再通过界面或接口返回。

CF_DIR = "/etc/letsencrypt/sbm-cf"
ZONE_RE = re.compile(r"^(?=.{4,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{20,100}$")


def domains(conf):
    """域名列表；旧配置没有 domains 时，把原来唯一的主域名和 Token 迁移进来。"""
    if "domains" not in conf:
        conf["domains"] = [{"zone": base_domain(conf), "token_file": CF_INI, "note": "",
                            "added": datetime.now().strftime("%Y-%m-%d %H:%M")}]
    return conf["domains"]


def get_domain(conf, zone):
    for d in domains(conf):
        if d["zone"] == zone:
            return d
    raise SbmError(f"域名 {zone} 不在列表里，请先在「域名管理」中添加")


def domain_usage(conf, zone):
    """哪些地方在用这个域名（订阅域名、节点），删除前要检查。"""
    under = lambda host: host == zone or host.endswith("." + zone)
    used = [f"订阅 {conf['sub_domain']}"] if under(conf["sub_domain"]) else []
    return used + [f"节点 {n['name']}" for n in conf["nodes"] if n.get("managed") and under(n["server"])]


def read_token(token_file):
    try:
        with open(token_file, encoding="utf-8") as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() == "dns_cloudflare_api_token" and v.strip():
                    return v.strip()
    except FileNotFoundError:
        pass
    raise SbmError(f"{token_file} 里没有 Cloudflare Token")


def write_token(token_file, token):
    """直接以 600 权限创建临时文件再替换，Token 任何时候都不会被其他用户读到。"""
    os.makedirs(os.path.dirname(token_file), mode=0o700, exist_ok=True)
    tmp = f"{token_file}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(f"dns_cloudflare_api_token = {token}\n")
    os.replace(tmp, token_file)


def cf_request(token, method, path, body=None):
    req = urllib.request.Request(
        "https://api.cloudflare.com/client/v4" + path,
        method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        try:
            data = json.load(e)
        except ValueError:
            raise SbmError(f"Cloudflare API 返回 HTTP {e.code}")
    except (urllib.error.URLError, OSError) as e:
        raise SbmError(f"连接 Cloudflare API 失败: {e}")
    if not data.get("success"):
        msgs = "; ".join(f"{x.get('code')} {x.get('message')}" for x in data.get("errors", []))
        raise SbmError(f"Cloudflare API 出错: {msgs or data}")
    return data["result"]


def cf_zone_id(token, zone):
    zones = cf_request(token, "GET", "/zones?" + urllib.parse.urlencode({"name": zone}))
    if not zones:
        raise SbmError(f"Token 无权访问 {zone}，或这个域名不在该 Token 所属的 Cloudflare 账号下")
    return zones[0]


def verify_token(zone, token, write_test=True):
    """检查 Token 能否管理这个域名的 DNS。write_test 时创建并立即删除一条 TXT 记录来确认编辑权限。
    返回给界面显示的结果列表。"""
    try:
        z = cf_zone_id(token, zone)
    except SbmError as e:
        if "Invalid API Token" in str(e) or "1000" in str(e) or "6003" in str(e) or "9109" in str(e):
            raise SbmError("Token 无效或已被删除，请在 Cloudflare 重新创建")
        raise
    result = [f"可以访问 {zone}"]
    if z.get("status") != "active":
        result.append(f"⚠ 域名在 Cloudflare 的状态是 {z.get('status')}（NS 可能还没改到 Cloudflare），解析暂时不会生效")
    cf_request(token, "GET", f"/zones/{z['id']}/dns_records?per_page=1")
    result.append("可以读取 DNS 记录")
    if write_test:
        try:
            rec = cf_request(token, "POST", f"/zones/{z['id']}/dns_records",
                             {"type": "TXT", "name": f"_sbm-check.{zone}", "content": "sbm token check", "ttl": 60})
        except SbmError as e:
            raise SbmError(f"Token 没有 DNS 编辑权限（创建 Token 时请用 Edit zone DNS 模板）: {e}")
        cf_request(token, "DELETE", f"/zones/{z['id']}/dns_records/{rec['id']}")
        result.append("可以编辑 DNS 记录（已创建并删除测试记录）")
    return result


def domain_check(conf, zone):
    d = get_domain(conf, zone)
    return verify_token(zone, read_token(d["token_file"]), write_test=False)


def domain_add(conf, zone, token, note=""):
    zone = (zone or "").strip().lower().rstrip(".")
    token = (token or "").strip()
    if not ZONE_RE.match(zone):
        raise SbmError("域名格式不对，请填主域名，例如 example.com")
    if any(d["zone"] == zone for d in domains(conf)):
        raise SbmError(f"域名 {zone} 已经在列表里；要换 Token 请用「更换 Token」")
    if not TOKEN_RE.match(token):
        raise SbmError("Token 格式不对，请完整复制 Cloudflare 生成的 API Token")
    result = verify_token(zone, token)
    token_file = f"{CF_DIR}/{zone}.ini"
    write_token(token_file, token)
    domains(conf).append({"zone": zone, "token_file": token_file, "note": (note or "").strip()[:64],
                          "added": datetime.now().strftime("%Y-%m-%d %H:%M")})
    save_conf(conf)
    return result


def domain_set_token(conf, zone, token):
    """更换 Token：写回原文件，证书续期配置里记录的路径不变，自动用上新 Token。"""
    d = get_domain(conf, zone)
    token = (token or "").strip()
    if not TOKEN_RE.match(token):
        raise SbmError("Token 格式不对，请完整复制 Cloudflare 生成的 API Token")
    result = verify_token(zone, token)
    write_token(d["token_file"], token)
    return result


def domain_set_default(conf, zone):
    get_domain(conf, zone)
    conf["base_domain"] = zone
    save_conf(conf)


def domain_del(conf, zone):
    d = get_domain(conf, zone)
    used = domain_usage(conf, zone)
    if used:
        raise SbmError(f"{zone} 还在使用中（{'、'.join(used)}），不能删除")
    if base_domain(conf) == zone:
        raise SbmError("这是默认域名，请先把其他域名设为默认")
    conf["domains"] = [x for x in domains(conf) if x["zone"] != zone]
    save_conf(conf)
    # 只删除 sbm 自己建的 Token 文件
    if d["token_file"].startswith(CF_DIR + "/") and os.path.exists(d["token_file"]):
        os.remove(d["token_file"])


def cf_upsert_a(zone_name, fqdn, ip, log, token_file):
    token = read_token(token_file)
    zid = cf_zone_id(token, zone_name)["id"]
    record = {"type": "A", "name": fqdn, "content": ip, "ttl": 120, "proxied": False}
    found = cf_request(token, "GET", f"/zones/{zid}/dns_records?" + urllib.parse.urlencode({"type": "A", "name": fqdn}))
    if found and found[0]["content"] == ip and not found[0]["proxied"]:
        log(f"  {fqdn} → {ip} 已存在，无需修改")
    elif found:
        cf_request(token, "PUT", f"/zones/{zid}/dns_records/{found[0]['id']}", record)
        log(f"  已更新 {fqdn} → {ip}（原来指向 {found[0]['content']}）")
    else:
        cf_request(token, "POST", f"/zones/{zid}/dns_records", record)
        log(f"  已添加 {fqdn} → {ip}")


def issue_cert(fqdn, log, token_file):
    # 证书的续期配置会记住 token_file 路径，以后续期自动使用同一个域名的 Token
    r = subprocess.run(
        ["certbot", "certonly", "--non-interactive", "--agree-tos", "--register-unsafely-without-email",
         "--dns-cloudflare", "--dns-cloudflare-credentials", token_file,
         "--dns-cloudflare-propagation-seconds", "30",
         "--keep-until-expiring", "--cert-name", fqdn, "-d", fqdn],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        raise SbmError("申请证书失败:\n" + (r.stdout + r.stderr).strip()[-1500:])
    end = subprocess.run(
        ["openssl", "x509", "-enddate", "-noout", "-in", f"/etc/letsencrypt/live/{fqdn}/fullchain.pem"],
        capture_output=True, text=True,
    ).stdout.strip().replace("notAfter=", "")
    log(f"  证书有效期至 {end}")


def cert_dir(node):
    return f"{kernel_of(node)['dir']}/certs/{node['server']}"


def push_cert(node, log):
    """证书只在订阅服务器上申请和续期（Cloudflare Token 不下发到节点），续期后推送过去。"""
    fqdn = node["server"]
    d = shlex.quote(cert_dir(node))
    for name, mode in (("fullchain.pem", "644"), ("privkey.pem", "600")):
        with open(f"/etc/letsencrypt/live/{fqdn}/{name}", encoding="utf-8") as f:
            pem = f.read()
        r = ssh(node, f"mkdir -p {d} && umask 077 && cat > {d}/{name}.new && chmod {mode} {d}/{name}.new && mv {d}/{name}.new {d}/{name}", stdin=pem)
        if r.returncode != 0:
            raise SbmError(f"上传 {name} 失败: {r.stderr.strip()}")
    # 如果服务以非 root 用户运行，私钥要归它所有
    # （不用 systemctl show --value：CentOS 7 的 systemd 219 不支持）
    ssh(node, f'u=$(systemctl show -p User {kernel_of(node)["service"]} | cut -d= -f2-); [ -n "$u" ] && chown -R "$u" {d} || true')
    log(f"  证书已上传到 {cert_dir(node)}")


INSTALL_SCRIPT = r"""
set -e
if command -v sing-box >/dev/null; then echo "已安装 $(sing-box version | head -1)"; exit 0; fi
if ! command -v curl >/dev/null; then
    (apt-get update -qq && apt-get install -y -qq curl) || dnf install -y curl || yum install -y curl
fi
curl -fsSL https://sing-box.app/install.sh | sh >/tmp/sbm-install.log 2>&1 || { tail -20 /tmp/sbm-install.log; exit 1; }
echo "安装完成 $(sing-box version | head -1)"
"""

START_SCRIPT = r"""
set -e
p=/etc/sing-box/config.json
mkdir -p /etc/sing-box
cat > "$p.new"
sing-box check -c "$p.new"
if [ -s "$p" ] && ! cmp -s "$p" "$p.new"; then cp -a "$p" "$p.sbm-pre-$(date +%Y%m%d-%H%M%S)"; fi
mv "$p.new" "$p"
# 官方服务文件用 User=sing-box + StateDirectory + AmbientCapabilities。
# 旧 systemd（如 CentOS 7 的 219）不支持后两者，rpm 包也不一定创建该用户，
# 这时改为以 root 运行并预先建好数据目录（与 Debian/Ubuntu 上手动部署的方式一致）
sv=$(systemctl --version | awk 'NR==1{print $2}')
if [ "$sv" -lt 235 ] || ! id sing-box >/dev/null 2>&1; then
    mkdir -p /etc/systemd/system/sing-box.service.d
    printf '[Service]\nUser=root\nExecStartPre=/bin/mkdir -p /var/lib/sing-box\n' \
        > /etc/systemd/system/sing-box.service.d/sbm-compat.conf
    systemctl daemon-reload
    echo "systemd $sv：已添加兼容配置，sing-box 以 root 运行"
fi
systemctl enable sing-box >/dev/null 2>&1
systemctl restart sing-box
sleep 2
systemctl is-active --quiet sing-box || { journalctl -u sing-box -n 15 --no-pager; exit 1; }
echo "sing-box 运行中"
"""

# 第一次部署和后续升级共用：新版本先校验现有配置，重启失败自动换回旧版本
PRISM_INSTALL_SCRIPT = r"""
set -e
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/pkg"
echo "{sha}  $tmp/pkg" | sha256sum -c --quiet -
tar -xzf "$tmp/pkg" -C "$tmp" prism-node-server
new="$tmp/prism-node-server"; bin=/usr/local/bin/prism-node-server; cfg=/etc/prism-node-server/config.json
"$new" version >/dev/null || {{ echo "安装包无法在这台服务器上运行"; exit 1; }}
cur=""
if [ -x "$bin" ]; then cur=$("$bin" version | awk '{{print $2}}'); cp -a "$bin" "$tmp/prev"; fi
if [ "$cur" = "{ver}" ]; then echo "已是 {ver}，无需升级"; exit 0; fi
if [ -s "$cfg" ]; then "$new" check -c "$cfg" >/dev/null || {{ echo "新版本无法通过当前配置的校验"; exit 1; }}; fi
install -m 755 "$new" "$bin"
if ! systemctl is-active --quiet prism-node-server; then echo "已安装 $("$bin" version)"; exit 0; fi
systemctl restart prism-node-server
sleep 2
if ! systemctl is-active --quiet prism-node-server || ! "$bin" stats -c "$cfg" >/dev/null 2>&1; then
    journalctl -u prism-node-server -n 10 --no-pager
    install -m 755 "$tmp/prev" "$bin"
    systemctl restart prism-node-server
    echo "已回滚到 $cur"
    exit 1
fi
echo "升级完成: $cur → {ver}"
"""

# systemd 229 起才有 AmbientCapabilities，这时用专用账号运行；旧系统（如 CentOS 7）只能用 root
PRISM_SERVICE_SCRIPT = r"""
set -e
sv=$(systemctl --version | awk 'NR==1{print $2}')
user=""
if [ "$sv" -ge 229 ]; then
    id prism-node >/dev/null 2>&1 || useradd -r -M -s "$(command -v nologin || echo /bin/false)" prism-node
    user="User=prism-node"
fi
mkdir -p /etc/prism-node-server
chmod 755 /etc/prism-node-server
cat > /etc/systemd/system/prism-node-server.service <<EOF
[Unit]
Description=prism-node-server
After=network-online.target
Wants=network-online.target

[Service]
$user
ExecStart=/usr/local/bin/prism-node-server run -c /etc/prism-node-server/config.json
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable prism-node-server >/dev/null 2>&1
echo "服务已配置（systemd $sv，${user:-以 root 运行}）"
"""

PRISM_START_SCRIPT = r"""
set -e
p=/etc/prism-node-server/config.json
trap 'rm -f "$p.new"' EXIT
umask 077
cat > "$p.new"
prism-node-server check -c "$p.new"
if [ -s "$p" ] && ! cmp -s "$p" "$p.new"; then cp -a "$p" "$p.sbm-pre-$(date +%Y%m%d-%H%M%S)"; fi
mv "$p.new" "$p"
u=$(systemctl show -p User prism-node-server | cut -d= -f2-)
if [ -n "$u" ]; then chown "$u" "$p"; fi
systemctl restart prism-node-server
sleep 2
systemctl is-active --quiet prism-node-server && prism-node-server stats -c "$p" >/dev/null 2>&1 || { journalctl -u prism-node-server -n 15 --no-pager; exit 1; }
echo "prism-node-server 运行中"
"""

FIREWALL_SCRIPT = r"""
port={port}
if command -v ufw >/dev/null && ufw status | grep -q "Status: active"; then
    ufw allow $port/tcp >/dev/null && echo "ufw 已放行 $port/tcp"
elif command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --permanent --add-port=$port/tcp >/dev/null && firewall-cmd --reload >/dev/null && echo "firewalld 已放行 $port/tcp"
else
    echo "系统防火墙未启用，无需放行"
fi
"""


def listen_port(node):
    """节点进程实际监听的端口。node["port"] 是客户端连接的公网端口，NAT 机器上两者可能不同。"""
    return node.get("listen_port", node["port"])


def node_config(node, cred_list, marks):
    inbound = {
        "type": "anytls",
        "tag": node["inbound_tag"],
        "listen": "::",
        "listen_port": listen_port(node),
        "users": cred_list,
        "tls": {
            "enabled": True,
            "server_name": node["server"],
            "certificate_path": f"{cert_dir(node)}/fullchain.pem",
            "key_path": f"{cert_dir(node)}/privkey.pem",
        },
    }
    if is_prism(node):
        return {"log": {"level": "info"}, "inbounds": [inbound]}  # 流量统计内置，不需要出站和路由规则
    cfg = {
        "log": {"level": "info"},
        "inbounds": [inbound],
        "outbounds": [{"type": "direct", "tag": "direct"}],
        "route": {"rules": [{"inbound": [node["inbound_tag"]], "action": "sniff"}]},
    }
    apply_stats_routing(cfg, cred_list, marks)
    return cfg


def resolve_ipv4(host):
    try:
        return socket.gethostbyname(host)
    except OSError:
        raise SbmError(f"无法解析 {host}")


def verify_tls(node, log):
    r = subprocess.run(
        ["timeout", "12", "openssl", "s_client", "-connect", f"{node['host']}:{node['port']}",
         "-servername", node["server"], "-verify_hostname", node["server"]],
        input="", capture_output=True, text=True,
    )
    # 握手被中断、没有收到证书时 openssl 也会输出 return code 0，要同时确认协商出了加密套件
    if "Verify return code: 0 (ok)" in r.stdout and "Cipher is (NONE)" not in r.stdout:
        log("  TLS 握手正常，证书有效")
    else:
        # 订阅服务器在国内，到境外节点的直连握手可能被干扰，不影响部署结果
        log("  ⚠ 从订阅服务器验证 TLS 未通过（国内直连境外可能被干扰，大陆机房可能拦截未备案域名），请用客户端实际连接确认")


def deploy_node(conf, users, name, host, ssh_port, sub, port, zone=None, log=print, kernel=DEFAULT_KERNEL, listen=None):
    """在全新服务器上部署 AnyTLS 节点：DNS → 证书 → 安装内核 → 写配置 → 加入订阅。
    zone 为域名管理里的某个主域名，不指定时用默认域名。
    port 是客户端连接的公网端口；listen 是服务器内部监听的端口，NAT 机器才需要指定。"""
    ssh_port, port = int(ssh_port), int(port)
    listen = int(listen or port)
    check_node_args(conf, name, host, ssh_port)
    if kernel not in KERNELS:
        raise SbmError(f"不支持的内核: {kernel}")
    if not SUB_RE.match(sub or ""):
        raise SbmError("子域名前缀只能用小写字母、数字和 -")
    if not (1 <= port <= 65535 and 1 <= listen <= 65535):
        raise SbmError("节点端口无效")
    zone = zone or base_domain(conf)
    token_file = get_domain(conf, zone)["token_file"]
    fqdn = f"{sub}.{zone}"
    if fqdn == conf["sub_domain"] or any(n["server"] == fqdn for n in conf["nodes"]):
        raise SbmError(f"域名 {fqdn} 已被使用")
    creds = load_creds()
    cred_list = node_credentials(users, creds)
    if not cred_list:
        raise SbmError("还没有任何账号，请先运行 sbm sync 生成账号池")
    save_creds(creds)  # node_credentials 可能分配了新的统计编号
    node = {
        "name": name, "host": host, "ssh_user": "root", "ssh_port": ssh_port, "ssh_key": KEY,
        "config_path": "/etc/sing-box/config.json", "inbound_tag": "anytls-in",
        "server": fqdn, "port": port, "sni": fqdn, "managed": True, "zone": zone,
    }
    if kernel != DEFAULT_KERNEL:
        node["kernel"] = kernel
        node["config_path"] = f"{kernel_of(node)['dir']}/config.json"
    if listen != port:
        node["listen_port"] = listen
    label = kernel_of(node)["label"]
    version = releases(kernel=kernel)["latest"] if is_prism(node) else None  # 先确认有版本可装，再动 DNS 和证书

    log("[1/7] 检查 SSH 连接")
    check_root_ssh(node, log)
    busy = ssh(node, f"ss -Htlnp 'sport = :{listen}'").stdout.strip()
    if busy and kernel_of(node)["comm"] not in busy:
        raise SbmError(f"端口 {listen} 已被其他程序占用:\n{busy}")

    log(f"[2/7] 设置 DNS 解析 {fqdn}")
    cf_upsert_a(zone, fqdn, resolve_ipv4(host), log, token_file)

    log("[3/7] 申请 TLS 证书（DNS 验证，约 1 分钟）")
    issue_cert(fqdn, log, token_file)

    log(f"[4/7] 安装 {label}")
    if is_prism(node):
        for line in install_prism(conf, node, version, log):
            log("  " + line)
        log("  " + ssh_ok(node, PRISM_SERVICE_SCRIPT, "配置服务").splitlines()[-1])
    else:
        log("  " + ssh_ok(node, INSTALL_SCRIPT, "安装 sing-box").splitlines()[-1])

    log("[5/7] 上传证书")
    push_cert(node, log)

    log("[6/7] 写入配置并启动")
    r = ssh(node, PRISM_START_SCRIPT if is_prism(node) else START_SCRIPT,
            stdin=json.dumps(node_config(node, cred_list, creds["marks"]), indent=2, ensure_ascii=False) + "\n")
    if r.returncode != 0:
        raise SbmError(f"启动 {label} 失败:\n" + (r.stdout + r.stderr).strip()[-1500:])
    for line in r.stdout.strip().splitlines():
        log("  " + line)
    log("  " + ssh_ok(node, FIREWALL_SCRIPT.format(port=listen), "配置防火墙").splitlines()[-1])
    if is_prism(node):
        log("  流量统计由内核提供，不需要 iptables 规则")
    else:
        # 防火墙重载会清掉计数规则，所以放在它之后安装
        install_stats(node, cred_list, creds["marks"])
        log("  已启用流量统计")

    log("[7/7] 验证并加入订阅")
    verify_tls(node, log)
    conf["nodes"].append(node)
    save_conf(conf)
    build_subs(conf, users)
    log(f"完成：节点 {name}（{fqdn}:{port}，{label}）已加入所有用户的订阅")
    if listen != port:
        log(f"提醒：请确认服务商已把公网 TCP {port} 映射到服务器内部的 {listen}")
    else:
        log(f"提醒：如果云服务商有安全组，请放行 TCP {port}")


def attach_node(conf, users, name, host, ssh_port, inbound_tag="anytls-in",
                config_path="/etc/sing-box/config.json", server=None, log=print):
    """接入已经装好 sing-box 的服务器：读取它的 AnyTLS 入站，推送用户，加入订阅。"""
    ssh_port = int(ssh_port)
    check_node_args(conf, name, host, ssh_port)
    node = {
        "name": name, "host": host, "ssh_user": "root", "ssh_port": ssh_port, "ssh_key": KEY,
        "config_path": config_path, "inbound_tag": inbound_tag, "managed": False,
    }
    log("[1/3] 检查 SSH 连接")
    check_root_ssh(node, log)

    log("[2/3] 读取节点配置")
    raw = ssh_ok(node, f"cat {shlex.quote(config_path)}", f"读取 {config_path} ")
    try:
        cfg = json.loads(raw)
    except ValueError as e:
        raise SbmError(f"{config_path} 不是合法的 JSON: {e}")
    inbound = next((i for i in cfg.get("inbounds", []) if i.get("tag") == inbound_tag), None)
    if inbound is None:
        tags = ", ".join(f"{i.get('tag')}({i.get('type')})" for i in cfg.get("inbounds", []))
        raise SbmError(f"没有 tag 为 {inbound_tag} 的入站。现有入站: {tags or '无'}")
    if inbound.get("type") != "anytls":
        raise SbmError(f"入站 {inbound_tag} 的类型是 {inbound.get('type')}，目前只支持 anytls")
    sni = server or inbound.get("tls", {}).get("server_name")
    if not sni:
        raise SbmError("入站 TLS 没有 server_name，请手动填写节点域名")
    node.update({"server": sni, "sni": sni, "port": int(inbound["listen_port"])})
    log(f"  AnyTLS 入站：{sni}:{node['port']}，现有 {len(inbound.get('users', []))} 个用户")

    log("[3/3] 推送用户并加入订阅")
    creds = load_creds()
    cred_list = node_credentials(users, creds)
    save_creds(creds)
    ok, msg = push_node(node, cred_list, creds["marks"])
    if not ok:
        raise SbmError(f"推送用户失败:\n{msg}")
    log(f"  节点 {msg}")
    conf["nodes"].append(node)
    save_conf(conf)
    build_subs(conf, users)
    log(f"完成：节点 {name} 已加入所有用户的订阅。节点上原有的用户已被 sbm 的用户列表替换")


def remove_node(conf, users, name, log=print):
    """只从管理列表和订阅中移除；服务器、DNS 和证书保持原样。"""
    if not any(n["name"] == name for n in conf["nodes"]):
        raise SbmError(f"节点 {name} 不存在")
    if len(conf["nodes"]) == 1:
        raise SbmError("这是最后一个节点，移除后订阅将没有可用节点")
    conf["nodes"] = [n for n in conf["nodes"] if n["name"] != name]
    save_conf(conf)
    build_subs(conf, users)
    log(f"节点 {name} 已从订阅中移除（服务器本身未做改动）")


# ---------- 内核版本 ----------

VERSION_RE = re.compile(r"^\d+\.\d+\.\d+(-(alpha|beta|rc)\.\d+)?$")
STABLE_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")
RELEASE_CACHE = f"{ETC}/.releases.json"
RELEASE_TTL = 1800  # GitHub 未认证 API 每小时只有 60 次
PRISM_CACHE = f"{ETC}/bin/prism"  # 备份不包含 etc/sbm/bin
PRISM_ARCH = {"x86_64": "amd64", "aarch64": "arm64"}


def _github(repo, path):
    req = urllib.request.Request(f"https://api.github.com/repos/{repo}" + path,
                                 headers={"Accept": "application/vnd.github+json", "User-Agent": "sbm"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.load(resp)


def releases(refresh=False, kernel=DEFAULT_KERNEL):
    """返回 {"latest": "1.14.3", "stable": [最近的正式版...], "checked": 时间戳}，失败时用缓存。"""
    info = KERNELS[kernel]
    cache_file = RELEASE_CACHE if kernel == DEFAULT_KERNEL else f"{ETC}/.releases-{kernel}.json"
    cache = load(cache_file, {})
    if cache and not refresh and time.time() - cache.get("checked", 0) < RELEASE_TTL:
        return cache
    try:
        latest = _github(info["repo"], "/releases/latest")["tag_name"].lstrip("v")
        # 完整的 releases 列表很大，从国内下载容易超时；tags 列表小得多
        tags = [t["name"] for t in _github(info["repo"], "/tags?per_page=60")]
        stable = sorted({tuple(map(int, m.groups())) for t in tags if (m := STABLE_RE.match(t))}, reverse=True)
        data = {"latest": latest, "stable": [".".join(map(str, v)) for v in stable[:10]], "checked": time.time()}
        write_file(cache_file, json.dumps(data) + "\n", 0o600)
        return data
    except (OSError, ValueError, KeyError) as e:
        if cache:
            return dict(cache, stale=True)
        if isinstance(e, urllib.error.HTTPError) and e.code == 404:
            raise SbmError(f"{info['label']}（{info['repo']}）在 GitHub 上还没有发布版本")
        raise SbmError(f"无法从 GitHub 获取 {info['label']} 版本信息: {e}")


def node_version(node):
    r = ssh(node, kernel_of(node)["version"])
    return r.stdout.strip() if r.returncode == 0 else ""


def _download(url, limit):
    """直连下载，总时长不超过 limit 秒：国内到 GitHub 的下载可能一直很慢但不断开。"""
    req = urllib.request.Request(url, headers={"User-Agent": "sbm"})
    deadline = time.monotonic() + limit
    chunks = []
    with urllib.request.urlopen(req, timeout=20) as resp:
        while chunk := resp.read1(65536):
            chunks.append(chunk)
            if time.monotonic() > deadline:
                raise TimeoutError(f"{limit} 秒内没有下载完")
    return b"".join(chunks)


def fetch_url(conf, url):
    """下载一个文件。订阅服务器在国内，直连 GitHub 下载常常失败，失败时让能连上的节点代为下载。"""
    try:
        return _download(url, 30 if conf["nodes"] else 600)  # 没有节点可以代为下载时，再慢也只能等
    except urllib.error.HTTPError as e:
        if e.code == 404:
            raise SbmError(f"找不到 {url}")
        err = e
    except OSError as e:
        err = e
    for node in conf["nodes"]:
        r = subprocess.run(ssh_args(node, f"curl -fsSL --connect-timeout 10 --retry 2 --max-time 120 {shlex.quote(url)}"),
                           capture_output=True, stdin=subprocess.DEVNULL)
        if r.returncode == 0 and r.stdout:
            return r.stdout
    raise SbmError(f"下载 {url} 失败: {err}")


def prism_package(conf, version, arch, log):
    """返回 Prism 安装包的 (内容, sha256)。订阅服务器下载并校验一次后缓存，由它推送给节点，
    所以节点不需要能连上 GitHub。"""
    name = f"prism-node-server-{version}-linux-{arch}.tar.gz"
    d = f"{PRISM_CACHE}/{version}"
    path, sums_path = f"{d}/{name}", f"{d}/SHA256SUMS"
    cached = os.path.exists(path) and os.path.exists(sums_path)
    if cached:
        with open(path, "rb") as f:
            data = f.read()
        with open(sums_path, encoding="utf-8") as f:
            sums = f.read()
    else:
        base = f"https://github.com/{KERNELS['prism']['repo']}/releases/download/v{version}"
        log(f"  下载 {name}")
        sums = fetch_url(conf, f"{base}/SHA256SUMS").decode()
        data = fetch_url(conf, f"{base}/{name}")
    want = next((p[0] for p in map(str.split, sums.splitlines()) if len(p) == 2 and p[1].lstrip("*") == name), None)
    sha = hashlib.sha256(data).hexdigest()
    if sha != want:
        raise SbmError(f"{name} 的校验和不一致（期望 {want}，实际 {sha}）")
    if not cached:
        os.makedirs(d, mode=0o700, exist_ok=True)
        with open(f"{path}.tmp", "wb") as f:
            f.write(data)
        os.replace(f"{path}.tmp", path)
        write_private(sums_path, sums)
    return data, sha


def install_prism(conf, node, version, log=print):
    """把指定版本的 Prism 推送到节点并安装；节点已在运行时会重启，失败自动回滚。返回节点输出的各行。"""
    machine = ssh_ok(node, "uname -m", "读取服务器架构")
    arch = PRISM_ARCH.get(machine)
    if not arch:
        raise SbmError(f"Prism 还没有 {machine} 架构的版本")
    data, sha = prism_package(conf, version, arch, log)
    r = ssh_push(node, PRISM_INSTALL_SCRIPT.format(sha=sha, ver=version), data)
    if r.returncode != 0:
        raise SbmError((r.stdout + r.stderr).strip()[-1500:])
    return r.stdout.strip().splitlines()


UPGRADE_SCRIPT = r"""
set -e
ver={ver}
cur=$(sing-box version | awk 'NR==1{{print $3}}')
if [ "$cur" = "$ver" ]; then echo "已是 $ver，无需升级"; exit 0; fi
if dpkg -s sing-box >/dev/null 2>&1; then
    kind=deb; f="sing-box_${{ver}}_linux_$(dpkg --print-architecture).deb"
elif rpm -q sing-box >/dev/null 2>&1; then
    kind=rpm; f="sing-box_${{ver}}_linux_$(rpm --eval %_arch).rpm"
else
    kind=bin
    case $(uname -m) in
        x86_64) a=amd64 ;; aarch64) a=arm64 ;; armv7l) a=armv7 ;; i?86) a=386 ;;
        *) echo "不支持的架构 $(uname -m)"; exit 1 ;;
    esac
    f="sing-box-${{ver}}-linux-$a.tar.gz"
fi
url="https://github.com/SagerNet/sing-box/releases/download/v$ver/$f"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
echo "下载 $f"
curl -fsSL --retry 2 --max-time 300 -o "$tmp/$f" "$url" || {{ echo "下载失败: $url"; exit 1; }}
bin=$(command -v sing-box)
cp -a "$bin" "$tmp/sing-box.prev"
cp -a /etc/sing-box/config.json "$tmp/config.json"
case $kind in
    # --force-confold：保留已修改的 /etc/sing-box/config.json，避免 dpkg 停下来交互询问
    deb) DEBIAN_FRONTEND=noninteractive dpkg -i --force-confold --force-confdef "$tmp/$f" >"$tmp/log" 2>&1 \
            || {{ tail -15 "$tmp/log"; exit 1; }} ;;
    rpm) rpm -U --force --oldpackage "$tmp/$f" >"$tmp/log" 2>&1 || {{ tail -15 "$tmp/log"; exit 1; }} ;;
    bin) tar -xzf "$tmp/$f" -C "$tmp" && install -m 755 "$tmp"/sing-box-*/sing-box "$bin" ;;
esac
echo "已安装 $kind 包"
# 包管理器可能替换或另存配置文件，始终换回原来的配置
cmp -s "$tmp/config.json" /etc/sing-box/config.json || cp -a "$tmp/config.json" /etc/sing-box/config.json
systemctl daemon-reload
rollback() {{
    install -m 755 "$tmp/sing-box.prev" "$bin"
    systemctl restart sing-box
    echo "已回滚到 $cur（包管理器里记录的版本可能仍显示为 $ver）"
    exit 1
}}
sing-box check -c /etc/sing-box/config.json || {{ echo "新版本无法通过当前配置的校验"; rollback; }}
systemctl restart sing-box
sleep 2
systemctl is-active --quiet sing-box || {{ journalctl -u sing-box -n 10 --no-pager; rollback; }}
echo "升级完成: $cur → $(sing-box version | awk 'NR==1{{print $3}}')"
"""


def upgrade_nodes(conf, names, version=None, log=print):
    """逐个升级节点（每个节点会重启一次）。一个失败不影响其他节点，最后汇总。
    不指定版本时升到各自内核的最新正式版；指定版本时所选节点必须是同一种内核。"""
    if version and not VERSION_RE.match(version):
        raise SbmError(f"版本号格式不对: {version}")
    targets = [n for n in conf["nodes"] if n["name"] in names]
    missing = set(names) - {n["name"] for n in targets}
    if missing:
        raise SbmError(f"节点不存在: {', '.join(sorted(missing))}")
    kernels = {n.get("kernel", DEFAULT_KERNEL) for n in targets}
    if version and len(kernels) > 1:
        raise SbmError("所选节点的内核不同，不能升级到同一个版本，请分开升级")
    latest = {k: version or releases(kernel=k)["latest"] for k in kernels}
    if "prism" in kernels:
        # Prism 的计数在进程内，重启归零：先把上次采集之后的流量收上来
        try:
            collect(conf, log=lambda *_: None)
        except Exception as e:  # noqa: BLE001 - 统计失败不能阻止升级
            log(f"⚠ 升级前采集流量失败: {e}")
    failed = []
    for i, node in enumerate(targets, 1):
        target = latest[node.get("kernel", DEFAULT_KERNEL)]
        log(f"[{i}/{len(targets)}] {node['name']} → {kernel_of(node)['label']} {target}")
        if is_prism(node):
            try:
                for line in install_prism(conf, node, target, log):
                    log("  " + line)
            except SbmError as e:
                log(f"  {e}")
                failed.append(node["name"])
                log(f"  ✗ {node['name']} 升级失败")
            continue
        r = ssh(node, UPGRADE_SCRIPT.format(ver=target))
        for line in (r.stdout + r.stderr).strip().splitlines():
            log("  " + line)
        if r.returncode != 0:
            failed.append(node["name"])
            log(f"  ✗ {node['name']} 升级失败")
    if failed:
        raise SbmError(f"以下节点升级失败: {', '.join(failed)}")
    log(f"完成：{len(targets)} 个节点均为 {'、'.join(sorted(set(latest.values())))}")


def cert_renewed(conf, domains, log=print):
    """certbot 续期钩子：把续期后的证书推送到对应节点，sing-box 重启，Prism 热加载（连接不断）。"""
    for node in conf["nodes"]:
        if node.get("managed") and node["server"] in domains:
            push_cert(node, log)
            if is_prism(node):
                ssh_ok(node, f"prism-node-server reload -c {shlex.quote(node['config_path'])}", "重新加载 Prism")
                log(f"[{node['name']}] Prism 已加载新证书")
            else:
                ssh_ok(node, "systemctl restart sing-box", "重启 sing-box")
                log(f"[{node['name']}] 已重启 sing-box")


